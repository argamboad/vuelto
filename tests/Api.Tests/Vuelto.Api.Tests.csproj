<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Vuelto's backend tests: the platform's inherited suites (Perezosoft.Platform.Testing) run against this app's tree,
    model and host, beside the app's own tests under App/ (each slice's, the domain logic's — Core.Tests folded in — the mail and the
    vouchers').
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateLocalPorts>true</GenerateLocalPorts>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Perezosoft.Platform.Testing" />
    <!-- REPORTS-7: the report PDFs are read back. -->
    <PackageReference Include="PdfPig" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- Testcontainers pulls a vulnerable SSH.NET transitively; the patched pin. -->
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Host\Vuelto.Host.csproj" />
    <!-- The domain tests (Core.Tests, folded in) check the UI's display helpers against the server's rules. -->
    <ProjectReference Include="..\..\src\Shared.Ui\Vuelto.Shared.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- EMAIL-1: real anonymized BAC/BN voucher bodies for RealVoucherFixtureTests. -->
    <None Include="App\Vouchers\Fixtures\*.html" Link="Vouchers\Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
