<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Vuelto's journeys: Playwright drives the web host against a running API, db and Mailpit (`dotnet platform e2e`
    starts them). The base, BlazorBoot, Mailpit and Totp come from Perezosoft.Platform.Testing.E2E.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateLocalPorts>true</GenerateLocalPorts>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Perezosoft.Platform.Testing.E2E" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Playwright.NUnit" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

</Project>
