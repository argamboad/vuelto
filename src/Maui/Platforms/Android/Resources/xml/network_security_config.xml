<?xml version="1.0" encoding="utf-8"?>
<!-- Dev only: permit cleartext HTTP to the host machine as seen from the emulator
     (10.0.2.2) and to localhost. Everything else stays HTTPS-only. The API is reached
     over plain HTTP in dev so the emulator needn't trust the ASP.NET dev cert. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
