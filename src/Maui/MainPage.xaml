<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Perezosoft.Maui"
             xmlns:sharedui="clr-namespace:Perezosoft.Shared.Ui;assembly=Perezosoft.Shared.Ui"
             x:Class="Perezosoft.Maui.MainPage">

    <!-- Root on the SHARED RCL's App component (Router), not the platform's sample Routes. -->
    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type sharedui:App}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
