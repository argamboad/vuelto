@page "/categories"
@using Vuelto.Shared.Ui.Auth
@inject AuthService Auth
@inject NavigationManager Nav
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["Catalog_Categories_Title"]</PageTitle>

@* CATALOG-1: the household's categories (ADR-V008). *@
<div class="settings-wrapper">
    <CatalogPage Endpoint="/api/categories"
                 TitleKey="Catalog_Categories_Title"
                 SubtitleKey="Catalog_Categories_Subtitle"
                 NewKey="Catalog_Categories_New"
                 LoadErrorKey="Catalog_Categories_LoadError" />
    <p class="mt-3"><a href="/settings">← @Localizer["Catalog_BackToSettings"]</a></p>
</div>

@code {
    protected override void OnInitialized()
    {
        if (!Auth.IsAuthenticated) Nav.NavigateTo("/login");
    }
}
