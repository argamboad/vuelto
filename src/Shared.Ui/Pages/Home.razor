@page "/"
@using Vuelto.Shared.Ui.Auth
@inject AuthService Auth
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["Nav_Home"]</PageTitle>

@if (Auth.IsAuthenticated)
{
    <div class="welcome-wrapper">
        <div class="welcome-card card shadow-sm text-center">
            <div class="card-body p-4 p-md-5">
                <img src="_content/Vuelto.Shared.Ui/brand/lockup_light_1520.png" alt="¿Y el vuelto?"
                     class="welcome-lockup mb-4" />
                <h1 class="h3 fw-bold mb-1">@Localizer["Home_WelcomeBack", Auth.DisplayName ?? ""]</h1>
                <p class="text-muted mb-0">@Localizer["Home_SignedInTo", Auth.TenantName ?? ""]</p>
                <div class="mt-3">
                    <ExchangeRateBadge />
                </div>
                <div class="d-flex justify-content-center gap-2 mt-4">
                    <a class="btn btn-primary" href="/dashboard" data-testid="home-dashboard">@Localizer["Nav_Dashboard"]</a>
                    <a class="btn btn-outline-primary" href="/transactions/new" data-testid="home-new-tx">@Localizer["Months_NewTransaction"]</a>
                    <a class="btn btn-outline-primary" href="/months" data-testid="home-months">@Localizer["Nav_Months"]</a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="welcome-wrapper">
        <div class="hero-section text-center">
            <img src="_content/Vuelto.Shared.Ui/brand/lockup_light_1520.png" alt="¿Y el vuelto?"
                 class="welcome-lockup mb-4" />
            <p class="lead text-muted mb-4 mx-auto" style="max-width:480px">
                @Localizer["Home_HeroSubtitle"]
            </p>
            <a href="/login" class="btn btn-primary btn-lg px-5">@Localizer["Home_SignInCta"] &rarr;</a>
        </div>
    </div>
}
