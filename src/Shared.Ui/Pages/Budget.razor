@page "/budget"
@using System.Net.Http.Json
@using Vuelto.Shared.Ui.Auth
@using Vuelto.Shared.Ui.Components
@inject AuthService Auth
@inject NavigationManager Nav
@inject HttpClient Http
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["Budget_Title"]</PageTitle>

@* EXPENSES-1: the household's budget baseline — fixed and variable lines (ADR-V007). *@
<div class="settings-wrapper" data-testid="budget-page">
    <div class="mb-3">
        <h1 class="h4 fw-bold mb-1">@Localizer["Budget_Title"]</h1>
        <p class="text-muted mb-0">@Localizer["Budget_Subtitle"]</p>
    </div>

    @if (_loading)
    {
        <div class="text-muted"><span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Common_Loading"]</div>
    }
    else
    {
        @if (_error is not null)
        {
            <div class="alert alert-danger py-2" data-testid="budget-error">@_error</div>
        }
        <ExpenseLinesSection Kind="fixed" TitleKey="Budget_Fixed" NewKey="Budget_AddFixed" Categories="_categories" Banks="_banks" />
        <ExpenseLinesSection Kind="variable" TitleKey="Budget_Variable" NewKey="Budget_AddVariable" Categories="_categories" Banks="_banks" />
    }
</div>

@code {
    private bool _loading = true;
    private string? _error;
    private List<ExpenseLinesSection.NamedItem> _categories = new();
    private List<ExpenseLinesSection.NamedItem> _banks = new();

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login"); return; }
        try
        {
            _categories = await Http.GetFromJsonAsync<List<ExpenseLinesSection.NamedItem>>("/api/categories") ?? new();
            _banks = await Http.GetFromJsonAsync<List<ExpenseLinesSection.NamedItem>>("/api/banks?include_inactive=true") ?? new(); // all states: a deactivated bank still names its line
        }
        catch { _error = Localizer["Budget_LoadError"]; }
        finally { _loading = false; }
    }
}
