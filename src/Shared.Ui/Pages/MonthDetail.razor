@page "/months/{Id:guid}"
@using System.Globalization
@using System.Net
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@using Vuelto.Shared.Ui.Auth
@inject AuthService Auth
@inject NavigationManager Nav
@inject HttpClient Http
@inject IFileDownloadLauncher DownloadLauncher
@inject IStringLocalizer<AppStrings> Localizer
@inject DisplayCurrencyStore Display

<PageTitle>@(_month is null ? Localizer["Months_Title"] : MonthLabel(_month.Year, _month.MonthNumber))</PageTitle>

@* LEDGER-1/2: one budget month — its weeks, editable income, and its transactions (ADR-V005/V007), presented per
   SKIN-8: income collapses into one row, the ledger is one table with class chips and a stacked amount, and below md
   it hides columns instead of scrolling sideways. Sort and filter stay on the rows already loaded — no request. *@
<div class="settings-wrapper" data-testid="month-page">
    @if (_loading)
    {
        <div class="text-muted"><span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Common_Loading"]</div>
    }
    else if (_month is null)
    {
        <div class="alert alert-warning" data-testid="month-missing">@Localizer["Month_NotFound"]</div>
        <p><a href="/months">← @Localizer["Month_AllMonths"]</a></p>
    }
    else
    {
        <header class="month-head">
            <div class="month-head-main">
                <p class="month-crumbs">
                    <a href="/months" data-testid="month-back">← @Localizer["Month_AllMonths"]</a>
                    <span class="month-crumb-dot" aria-hidden="true">·</span>
                    <a href="/dashboard/@Id" data-testid="month-dashboard-link">@Localizer["Nav_Dashboard"]</a>
                </p>
                <h1 data-testid="month-title">@MonthLabel(_month.Year, _month.MonthNumber)</h1>
                <div class="month-weeks" data-testid="month-weeks">
                    @foreach (var w in _month.Weeks!)
                    {
                        @* "W1 · Aug 28": the start day is the scanning cue; the full window is one hover away. *@
                        <span class="month-week-chip" title="@($"{w.StartDate.ToString(ShortDay(), CultureInfo.CurrentCulture)} – {w.EndDate.ToString(ShortDay(), CultureInfo.CurrentCulture)}")">@Localizer["Month_WeekChip", w.WeekNumber, w.StartDate.ToString(ShortDay(), CultureInfo.CurrentCulture)]</span>
                    }
                </div>
            </div>
            <div class="month-head-buttons">
                <button class="btn btn-outline-secondary" data-testid="month-export" @onclick="ExportCsvAsync" disabled="@_exporting">@(_exporting ? Localizer["Reports_Exporting"] : Localizer["Reports_ExportCsv"])</button>
                <a class="btn btn-primary" href="/transactions/new" data-testid="month-new-tx">@Localizer["Months_NewTransaction"]</a>
            </div>
        </header>

        @if (_notice is not null)
        {
            <div class="alert alert-success py-2" data-testid="month-notice">@_notice</div>
        }
        @if (_error is not null)
        {
            <div class="alert alert-danger py-2" data-testid="month-error">@_error</div>
        }

        @* Income is one row: two amount-plus-currency groups and the save, wrapping field by field on phone. *@
        <section class="month-card month-income" data-testid="month-income">
            <div class="income-row">
                <div class="income-field">
                    <label class="form-label" for="inc-primary">@Localizer["Month_PrimaryIncome"]</label>
                    <div class="input-group">
                        <input class="form-control" type="number" step="0.01" min="0" id="inc-primary" data-testid="inc-primary" disabled="@_saving" @bind="_primaryAmount" />
                        <select class="form-select income-cur" aria-label="@Localizer["Tx_Currency"]" data-testid="inc-primary-cur" disabled="@_saving" @bind="_primaryCurrency"><option>CRC</option><option>USD</option></select>
                    </div>
                </div>
                <div class="income-field">
                    <label class="form-label" for="inc-secondary">@Localizer["Month_SecondaryIncome"]</label>
                    <div class="input-group">
                        <input class="form-control" type="number" step="0.01" min="0" id="inc-secondary" data-testid="inc-secondary" disabled="@_saving" @bind="_secondaryAmount" />
                        <select class="form-select income-cur" aria-label="@Localizer["Tx_Currency"]" data-testid="inc-secondary-cur" disabled="@_saving" @bind="_secondaryCurrency"><option>CRC</option><option>USD</option></select>
                    </div>
                </div>
                <button class="btn btn-outline-primary income-save" data-testid="inc-save" disabled="@_saving" @onclick="SaveIncome">@(_saving ? Localizer["Catalog_Saving"] : Localizer["Month_SaveIncome"])</button>
            </div>
            @* Money that came in as transactions (realized refunds, sales…) — counted in the dashboard's Income, listed here so the row and the dashboard agree. *@
            @{ var inflows = _transactions.Where(t => t.TransactionType == TransactionClasses.Inflow).ToList(); }
            @if (inflows.Count > 0)
            {
                <div class="income-other" data-testid="month-income-other">
                    <span class="income-other-label">@Localizer["Month_OtherIncome"]:</span>
                    <span class="income-other-amount">₡@inflows.Sum(t => t.AmountCrc).ToString("N2", CultureInfo.CurrentCulture) · $@inflows.Sum(t => t.AmountUsd).ToString("N2", CultureInfo.CurrentCulture)</span>
                    <button type="button" class="btn btn-link btn-sm p-0 align-baseline" data-testid="month-income-other-show" @onclick="() => _fClass = TransactionClasses.Inflow">@Localizer["Month_OtherIncomeShow", inflows.Count]</button>
                </div>
            }
        </section>

        <section class="month-card ledger" data-testid="month-tx-section">
            <div class="ledger-head">
                <h2>@Localizer["Month_Transactions"] <span class="count-pill" data-testid="month-tx-total">@_transactions.Count</span></h2>
                @if (_transactions.Count > 0)
                {
                    @* Filters compose, client-side, over the loaded month. Inline at md and up; below md the search stays
                       and the rest folds behind the toggle (the handout's sheet, as a disclosure rather than a modal). *@
                    <div class="ledger-filters" data-testid="month-tx-filters">
                        <input type="search" class="form-control form-control-sm ledger-search" placeholder="@Localizer["Month_SearchPayee"]" aria-label="@Localizer["Month_SearchPayee"]" data-testid="month-tx-filter-payee" @bind="_fPayee" @bind:event="oninput" />
                        <button type="button" class="btn btn-outline-secondary btn-sm filters-toggle" data-testid="month-tx-filters-toggle" aria-expanded="@(_filtersOpen ? "true" : "false")" aria-controls="month-filters-more" @onclick="() => _filtersOpen = !_filtersOpen">@Localizer["Month_Filters"]@(FiltersActive ? " •" : "")</button>
                        <div class="filters-more" id="month-filters-more" data-testid="month-tx-filters-more" data-open="@(_filtersOpen ? "true" : "false")">
                            <select class="form-select form-select-sm" aria-label="@Localizer["Tx_Category"]" data-testid="month-tx-filter-category" @bind="_fCategory">
                                <option value="">@Localizer["Month_FilterAllCategories"]</option>
                                @foreach (var c in Distinct(t => t.CategoryName)) { <option value="@c">@c</option> }
                            </select>
                            <select class="form-select form-select-sm" aria-label="@Localizer["Tx_Bank"]" data-testid="month-tx-filter-bank" @bind="_fBank">
                                <option value="">@Localizer["Month_FilterAllBanks"]</option>
                                @foreach (var b in Distinct(t => t.BankName)) { <option value="@b">@b</option> }
                            </select>
                            <select class="form-select form-select-sm" aria-label="@Localizer["Tx_Card"]" data-testid="month-tx-filter-card" @bind="_fCard">
                                <option value="">@Localizer["Month_FilterAllCards"]</option>
                                @foreach (var c in Distinct(t => t.CardName)) { <option value="@c">@c</option> }
                            </select>
                            <select class="form-select form-select-sm" aria-label="@Localizer["Tx_Class"]" data-testid="month-tx-filter-class" @bind="_fClass">
                                <option value="">@Localizer["Month_FilterAllClasses"]</option>
                                @foreach (var k in _transactions.Select(t => t.TransactionType).Distinct().OrderBy(k => ClassLabel(k), StringComparer.CurrentCultureIgnoreCase)) { <option value="@k">@ClassLabel(k)</option> }
                            </select>
                            <input type="date" class="form-control form-control-sm" aria-label="@Localizer["Month_FilterFrom"]" data-testid="month-tx-filter-from" @bind="_fFrom" />
                            <input type="date" class="form-control form-control-sm" aria-label="@Localizer["Month_FilterTo"]" data-testid="month-tx-filter-to" @bind="_fTo" />
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-testid="month-tx-filter-clear" disabled="@(!FiltersActive)" @onclick="ClearFilters">@Localizer["Month_FilterClear"]</button>
                        </div>
                        <span class="ledger-count" data-testid="month-tx-count">@Localizer["Month_FilterCount", Visible().Count, _transactions.Count]</span>
                    </div>
                }
            </div>
            @if (_transactions.Count == 0)
            {
                <p class="ledger-empty" data-testid="month-no-tx">@Localizer["Month_NoTransactions"]</p>
            }
            else
            {
                <table class="table ledger-table" data-testid="month-tx-table">
                    <thead>
                        <tr>
                            @SortHeader("date", Localizer["Tx_Date"], "")
                            @SortHeader("payee", Localizer["Tx_Payee"], "")
                            @SortHeader("category", Localizer["Tx_Category"], "col-md")
                            @SortHeader("bank", Localizer["Month_PaidWith"], "col-md")
                            @SortHeader("class", Localizer["Tx_Class"], "col-class")
                            <th scope="col" class="text-end">@Localizer["Tx_Amount"]</th>
                            <th scope="col" class="text-end"><span class="visually-hidden">@Localizer["Catalog_Edit"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Visible().Count == 0)
                        {
                            <tr><td colspan="7" class="ledger-nomatch" data-testid="month-tx-nomatch">@Localizer["Month_NoMatch"]</td></tr>
                        }
                        @foreach (var t in Visible())
                        {
                            <tr data-testid="month-tx-row">
                                <td class="tx-date">
                                    <span class="tx-date-long">@t.TransactionDate.ToString("d", CultureInfo.CurrentCulture)</span>
                                    <span class="tx-date-short" data-testid="month-tx-date-short">@t.TransactionDate.ToString(ShortDay(), CultureInfo.CurrentCulture)</span>
                                </td>
                                <td class="tx-payee-cell">
                                    <span class="tx-payee" data-testid="month-tx-payee">@t.Payee</span>
                                    @if (!string.IsNullOrWhiteSpace(t.Notes))
                                    {
                                        @* The note rides on the row as an icon: hover reads it; a tap opens the transaction, which shows it in full. *@
                                        <a class="tx-note" href="/transactions/@t.Id/edit" data-testid="month-tx-note" title="@t.Notes" aria-label="@t.Notes">
                                            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false"><path d="M2 1.5h8.5L14 5v9.5H2z" opacity=".3"/><path d="M4 7h8v1.2H4zm0 2.6h8v1.2H4zm0 2.6h5v1.2H4z"/></svg>
                                        </a>
                                    }
                                    @* Below md the category and paid-with columns hide; this sub-line repeats them so the row loses nothing. *@
                                    <span class="tx-sub" data-testid="month-tx-sub" aria-hidden="true">@SubLine(t)</span>
                                    @* On a phone the class column goes too, and the chip sits under the payee instead. *@
                                    <span class="tx-sub-chip" aria-hidden="true"><ClassChip Class="@t.TransactionType" TestId="month-tx-class-sub" /></span>
                                </td>
                                <td class="col-md" data-testid="month-tx-category">@t.CategoryName</td>
                                <td class="col-md tx-paid" data-testid="month-tx-paid">
                                    @t.BankName
                                    @if (!string.IsNullOrEmpty(t.CardName))
                                    {
                                        @* CARDS-1: the card's alias, as the household named it — never the number. *@
                                        <span class="tx-card" data-testid="month-tx-card">@t.CardName</span>
                                    }
                                </td>
                                <td class="col-class"><ClassChip Class="@t.TransactionType" TestId="month-tx-class" /></td>
                                <td class="text-end"><Money Crc="t.AmountCrc" Usd="t.AmountUsd" Display="@_display" Size="row" TestId="month-tx-amount" /></td>
                                <td class="text-end tx-actions">
                                    @if (t.Source != "refund_realization")
                                    {
                                        <a class="btn btn-outline-primary btn-sm" href="/transactions/@t.Id/edit" data-testid="month-tx-edit">@Localizer["Catalog_Edit"]</a>
                                        @if (_confirmDelete == t.Id)
                                        {
                                            <button class="btn btn-danger btn-sm" data-testid="month-tx-confirm" disabled="@_saving" @onclick="() => DeleteAsync(t.Id)">@Localizer["Month_ConfirmDelete"]</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-outline-danger btn-sm" data-testid="month-tx-delete" disabled="@_saving" @onclick="() => _confirmDelete = t.Id">@Localizer["Month_Delete"]</button>
                                        }
                                    }
                                    else
                                    {
                                        <span class="tx-derived">@Localizer["Tx_Derived"]</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        <section class="month-card ledger" data-testid="month-refund-section">
            <div class="ledger-head"><h2>@Localizer["Month_Refunds"] <span class="count-pill">@_refunds.Count</span></h2></div>
            @if (_refunds.Count == 0)
            {
                <p class="ledger-empty" data-testid="month-no-refunds">@Localizer["Month_NoRefunds"]</p>
            }
            else
            {
                <table class="table ledger-table" data-testid="month-refund-table">
                    <thead>
                        <tr>
                            <th scope="col">@Localizer["Tx_Date"]</th>
                            <th scope="col">@Localizer["Tx_Payee"]</th>
                            <th scope="col" class="text-end col-md">%</th>
                            <th scope="col" class="text-end">@Localizer["Tx_Amount"]</th>
                            <th scope="col" class="col-status">@Localizer["Catalog_Status"]</th>
                            <th scope="col" class="text-end"><span class="visually-hidden">@Localizer["Catalog_Edit"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _refunds)
                        {
                            <tr data-testid="month-refund-row">
                                <td class="tx-date">
                                    <span class="tx-date-long">@r.TransactionDate.ToString("d", CultureInfo.CurrentCulture)</span>
                                    <span class="tx-date-short">@r.TransactionDate.ToString(ShortDay(), CultureInfo.CurrentCulture)</span>
                                </td>
                                <td class="tx-payee-cell">
                                    <span class="tx-payee">@r.Payee</span>
                                    @if (!string.IsNullOrWhiteSpace(r.Notes))
                                    {
                                        @* Same affordance as a transaction's note: an icon that reads on hover. *@
                                        <span class="tx-note" data-testid="refund-note" title="@r.Notes" aria-label="@r.Notes">
                                            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false"><path d="M2 1.5h8.5L14 5v9.5H2z" opacity=".3"/><path d="M4 7h8v1.2H4zm0 2.6h8v1.2H4zm0 2.6h5v1.2H4z"/></svg>
                                        </span>
                                    }
                                    <span class="tx-sub" aria-hidden="true">@r.Percentage.ToString("N0", CultureInfo.CurrentCulture)%</span>
                                    @* On a phone the status column goes too; the pill sits under the payee. *@
                                    <span class="tx-sub-chip" aria-hidden="true"><span class="status-pill" data-tone="@(r.Status == "received" ? "good" : "warn")">@RefundStatusText(r)</span></span>
                                </td>
                                <td class="text-end col-md">@r.Percentage.ToString("N0", CultureInfo.CurrentCulture)%</td>
                                <td class="text-end"><Money Crc="r.AmountCrc" Usd="r.AmountUsd" Display="@_display" Size="row" TestId="refund-amount" /></td>
                                <td class="col-status">
                                    @* Pending needs attention (amber); received is done (green). The received day is the day the money
                                       landed, and the inflow lives in that day's month (ADR-V017). *@
                                    <span class="status-pill" data-tone="@(r.Status == "received" ? "good" : "warn")" data-testid="refund-status">@RefundStatusText(r)</span>
                                    @if (r.Status == "received" && r.InflowMonthId is { } other && other != Id)
                                    {
                                        <a class="refund-inflow" href="/months/@other" data-testid="refund-inflow-month">@Localizer["Refund_ViewInflowMonth"]</a>
                                    }
                                </td>
                                <td class="text-end tx-actions refund-actions">
                                    @if (r.Status != "received")
                                    {
                                        <label class="refund-date-label" for="received-@r.Id">@Localizer["Refund_ReceivedDate"]</label>
                                        <input type="date" id="received-@r.Id" class="form-control form-control-sm refund-date" data-testid="refund-received-date"
                                               min="@r.TransactionDate.ToString("yyyy-MM-dd")" @bind:get="ReceivedDateFor(r)" @bind:set="v => _receivedDates[r.Id] = v" />
                                    }
                                    <button class="btn btn-outline-secondary btn-sm" data-testid="refund-edit" disabled="@(_saving || _editingRefund == r.Id)" @onclick="() => OpenRefundEdit(r)">@Localizer["Catalog_Edit"]</button>
                                    <button class="btn btn-outline-primary btn-sm" data-testid="refund-toggle" disabled="@_saving" @onclick="() => FlipRefundAsync(r)"
                                            aria-label="@(r.Status == "received" ? Localizer["Refund_MarkPendingFor", r.Payee] : Localizer["Refund_MarkReceivedFor", r.Payee])">
                                        @(r.Status == "received" ? Localizer["Refund_MarkPending"] : Localizer["Refund_MarkReceived"])
                                    </button>
                                </td>
                            </tr>
                            @if (_editingRefund == r.Id)
                            {
                                @* LEDGER-4: why it is expected (case number and all — one field since 2026-09-14), the
                                   field the household owns, edited where the refund already is. *@
                                <tr data-testid="refund-edit-row">
                                    <td colspan="6">
                                        <div class="refund-edit">
                                            <div class="refund-edit-field refund-edit-notes">
                                                <label class="form-label" for="rnotes-@r.Id">@Localizer["Tx_RefundNotes"]</label>
                                                <input class="form-control form-control-sm" id="rnotes-@r.Id" data-testid="refund-notes-input" maxlength="250" placeholder="@Localizer["Refund_NotesHint"]" disabled="@_saving" @bind="_editNotes" @bind:event="oninput" />
                                            </div>
                                            <div class="refund-edit-buttons">
                                                <button class="btn btn-primary btn-sm" data-testid="refund-details-save" disabled="@_saving" @onclick="() => SaveRefundDetailsAsync(r)">@Localizer["Catalog_Save"]</button>
                                                <button class="btn btn-outline-secondary btn-sm" data-testid="refund-details-cancel" disabled="@_saving" @onclick="() => _editingRefund = null">@Localizer["Common_Cancel"]</button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
        </section>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private string? _notice;
    private bool _exporting;

    // REPORTS-2: the month's transactions as CSV through the platform download launcher (browser download / native share).
    private async Task ExportCsvAsync()
    {
        if (_exporting) return;
        _exporting = true; _notice = null; _error = null;
        try
        {
            var res = await Http.PostAsync($"/api/reports/transactions/export?month_id={Id}", null);
            res.EnsureSuccessStatusCode();
            var body = (await res.Content.ReadFromJsonAsync<ExportDto>())!;
            await DownloadLauncher.LaunchAsync(new Uri(Http.BaseAddress!, body.DownloadUrl).ToString(), body.FileName);
            _notice = Localizer["Reports_ExportReady", body.RowCount];
        }
        catch { _error = Localizer["Reports_ExportError"]; }
        finally { _exporting = false; }
    }

    private sealed record ExportDto([property: JsonPropertyName("download_url")] string DownloadUrl, [property: JsonPropertyName("file_name")] string FileName, [property: JsonPropertyName("row_count")] int RowCount);
    private MonthDto? _month;
    private List<TxDto> _transactions = new();
    private List<RefundDto> _refunds = new();
    private readonly Dictionary<Guid, DateOnly> _receivedDates = new();

    /// <summary>The date to book a pending refund on — today unless the user picked one (never before the purchase).</summary>
    private DateOnly ReceivedDateFor(RefundDto r) => _receivedDates.TryGetValue(r.Id, out var d) ? d : DateOnly.FromDateTime(DateTime.Today);
    private Guid? _confirmDelete;
    private decimal _primaryAmount;
    private string _primaryCurrency = "USD";
    private decimal _secondaryAmount;
    private string _secondaryCurrency = "USD";

    private Guid? _loadedId;

    private string _display = MoneyDisplay.Both;
    private bool _filtersOpen;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login"); return; }
        _display = await Display.LoadAsync();
        await LoadAsync();
    }

    /// <summary>A link from one month to another keeps this component alive with a new Id — reload for it.</summary>
    protected override async Task OnParametersSetAsync()
    {
        if (!_loading && _loadedId is { } loaded && loaded != Id) { _notice = null; _error = null; await LoadAsync(); }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadedId = Id;
        try
        {
            var res = await Http.GetAsync($"/api/months/{Id}");
            if (res.StatusCode == HttpStatusCode.NotFound) { _month = null; return; }
            res.EnsureSuccessStatusCode();
            _month = await res.Content.ReadFromJsonAsync<MonthDto>();
            _primaryAmount = _month!.PrimaryIncomeAmount; _primaryCurrency = _month.PrimaryIncomeCurrency;
            _secondaryAmount = _month.SecondaryIncomeAmount; _secondaryCurrency = _month.SecondaryIncomeCurrency;
            _transactions = await Http.GetFromJsonAsync<List<TxDto>>($"/api/months/{Id}/transactions") ?? new();
            _refunds = await Http.GetFromJsonAsync<List<RefundDto>>($"/api/months/{Id}/refunds") ?? new();
        }
        catch { _error = Localizer["Month_LoadError"]; }
        finally { _loading = false; }
    }

    /// <summary>LEDGER-3: pending → received books the derived inflow; received → pending removes it. A lost concurrent flip is a 409.</summary>
    private Guid? _editingRefund;
    private string _editNotes = "";

    private void OpenRefundEdit(RefundDto r)
    {
        _notice = null; _error = null;
        _editingRefund = r.Id;
        _editNotes = r.Notes ?? "";
    }

    private async Task SaveRefundDetailsAsync(RefundDto r)
    {
        _notice = null; _error = null; _saving = true;
        try
        {
            var res = await Http.PutAsJsonAsync($"/api/refunds/{r.Id}/details", new
            {
                notes = string.IsNullOrWhiteSpace(_editNotes) ? null : _editNotes.Trim(),
            });
            if (res.IsSuccessStatusCode) { _editingRefund = null; _notice = Localizer["Catalog_Updated"]; await LoadAsync(); }
            else _error = Localizer["Catalog_SaveError"];
        }
        catch { _error = Localizer["Catalog_SaveError"]; }
        finally { _saving = false; }
    }

    private async Task FlipRefundAsync(RefundDto r)
    {
        _notice = null; _error = null; _saving = true;
        try
        {
            var toReceived = r.Status != "received";
            var res = toReceived
                ? await Http.PutAsJsonAsync($"/api/refunds/{r.Id}", new { status = "received", received_date = ReceivedDateFor(r) })
                : await Http.PutAsJsonAsync($"/api/refunds/{r.Id}", new { status = "pending" });
            if (res.IsSuccessStatusCode) { _notice = Localizer["Refund_Updated"]; _receivedDates.Remove(r.Id); await LoadAsync(); }
            else if (res.StatusCode == HttpStatusCode.Conflict) { _error = Localizer["Refund_Conflict"]; await LoadAsync(); }
            else if (res.StatusCode == HttpStatusCode.BadRequest) _error = Localizer["Refund_DateInvalid"];
            else _error = Localizer["Refund_Error"];
        }
        catch { _error = Localizer["Refund_Error"]; }
        finally { _saving = false; }
    }

    private async Task SaveIncome()
    {
        _notice = null; _error = null; _saving = true;
        try
        {
            var res = await Http.PutAsJsonAsync($"/api/months/{Id}/income", new
            {
                primary_income_amount = _primaryAmount, primary_income_currency = _primaryCurrency,
                secondary_income_amount = _secondaryAmount, secondary_income_currency = _secondaryCurrency,
            });
            if (res.IsSuccessStatusCode) _notice = Localizer["Month_IncomeSaved"];
            else _error = (await res.Content.ReadFromJsonAsync<ErrorDto>())?.Message ?? Localizer["Month_IncomeError"];
        }
        catch { _error = Localizer["Month_IncomeError"]; }
        finally { _saving = false; }
    }

    private async Task DeleteAsync(Guid id)
    {
        _notice = null; _error = null; _saving = true;
        try
        {
            var res = await Http.DeleteAsync($"/api/transactions/{id}");
            if (!res.IsSuccessStatusCode) { _error = Localizer["Month_DeleteError"]; return; }
            _confirmDelete = null;
            _notice = Localizer["Month_Deleted"];
            await LoadAsync();
            if (_month is null) Nav.NavigateTo("/months"); // the month left with its last transaction (ADR-V005)
        }
        catch { _error = Localizer["Month_DeleteError"]; }
        finally { _saving = false; }
    }

    // ---- sort + filter (client-side over the loaded rows) ----

    private string _sortKey = "date";
    private bool _sortAsc = false; // the API's order: newest first
    private DateOnly? _fFrom, _fTo;
    private string _fPayee = "", _fCategory = "", _fBank = "", _fCard = "", _fClass = "";

    private bool FiltersActive => _fFrom is not null || _fTo is not null || _fPayee.Trim().Length > 0 || _fCategory.Length > 0 || _fBank.Length > 0 || _fCard.Length > 0 || _fClass.Length > 0;

    private void ClearFilters() { _fFrom = null; _fTo = null; _fPayee = ""; _fCategory = ""; _fBank = ""; _fCard = ""; _fClass = ""; }

    private void Sort(string key)
    {
        if (_sortKey == key) { _sortAsc = !_sortAsc; return; }
        _sortKey = key;
        _sortAsc = key != "date"; // names read A→Z first; dates newest first
    }

    private IEnumerable<string> Distinct(Func<TxDto, string?> pick) =>
        _transactions.Select(pick).Where(v => !string.IsNullOrEmpty(v)).Select(v => v!).Distinct().OrderBy(v => v, StringComparer.CurrentCultureIgnoreCase);

    /// <summary>The rows the filters let through, in the chosen order (ties by date desc so the list never shuffles between renders).</summary>
    private List<TxDto> Visible()
    {
        var payee = _fPayee.Trim();
        IEnumerable<TxDto> rows = _transactions.Where(t =>
            (_fFrom is not { } from || t.TransactionDate >= from) &&
            (_fTo is not { } to || t.TransactionDate <= to) &&
            (payee.Length == 0 || t.Payee.Contains(payee, StringComparison.CurrentCultureIgnoreCase)) &&
            (_fCategory.Length == 0 || string.Equals(t.CategoryName, _fCategory, StringComparison.Ordinal)) &&
            (_fBank.Length == 0 || string.Equals(t.BankName, _fBank, StringComparison.Ordinal)) &&
            (_fCard.Length == 0 || string.Equals(t.CardName, _fCard, StringComparison.Ordinal)) &&
            (_fClass.Length == 0 || string.Equals(t.TransactionType, _fClass, StringComparison.Ordinal)));

        var cmp = StringComparer.CurrentCultureIgnoreCase;
        var ordered = _sortKey switch
        {
            "payee" => _sortAsc ? rows.OrderBy(t => t.Payee, cmp) : rows.OrderByDescending(t => t.Payee, cmp),
            "category" => _sortAsc ? rows.OrderBy(t => t.CategoryName ?? "", cmp) : rows.OrderByDescending(t => t.CategoryName ?? "", cmp),
            // "Paid with" orders by bank; rows on the same bank keep date order (the card beneath is a detail, not a key).
            "bank" => _sortAsc ? rows.OrderBy(t => t.BankName ?? "", cmp) : rows.OrderByDescending(t => t.BankName ?? "", cmp),
            "class" => _sortAsc ? rows.OrderBy(t => ClassLabel(t.TransactionType), cmp) : rows.OrderByDescending(t => ClassLabel(t.TransactionType), cmp),
            _ => _sortAsc ? rows.OrderBy(t => t.TransactionDate) : rows.OrderByDescending(t => t.TransactionDate),
        };
        return ordered.ThenByDescending(t => t.TransactionDate).ThenBy(t => t.Payee, cmp).ToList();
    }

    /// <summary>A clickable header: click sorts by it, click again flips the direction; the arrow shows which and how.</summary>
    private RenderFragment SortHeader(string key, string label, string cssClass) => __builder =>
    {
        var active = _sortKey == key;
        <th scope="col" class="@cssClass" aria-sort="@(active ? (_sortAsc ? "ascending" : "descending") : "none")">
            <button type="button" class="sort-button" data-testid="@($"month-tx-sort-{key}")" @onclick="() => Sort(key)">
                @label@(active ? (_sortAsc ? " ▲" : " ▼") : "")
            </button>
        </th>
    };

    private string ClassLabel(string type) => TransactionClasses.LabelKey(type) is { } key ? Localizer[key] : type;

    private string RefundStatusText(RefundDto r) => r.Status == "received"
        ? (r.ReceivedDate is { } d ? Localizer["Refund_ReceivedOn", d.ToString("d", CultureInfo.CurrentCulture)] : Localizer["Refund_Received"])
        : Localizer["Refund_Pending"];

    /// <summary>"Groceries · Casa VISA" — what the hidden columns said, for the payee cell below md.</summary>
    private static string SubLine(TxDto t) =>
        string.Join(" · ", new[] { t.CategoryName, t.BankName, t.CardName }.Where(v => !string.IsNullOrEmpty(v)));

    /// <summary>"Sep 9" in English, "9 sept" in Spanish — the culture's month-day pattern with the month abbreviated.</summary>
    private static string ShortDay() =>
        CultureInfo.CurrentCulture.DateTimeFormat.MonthDayPattern.Replace("MMMM", "MMM").Replace("dd", "d").Replace(" 'de' ", " ");

    private static string MonthLabel(int year, int month) =>
        $"{CultureInfo.CurrentCulture.TextInfo.ToTitleCase(CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month))} {year}";

