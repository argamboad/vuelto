@page "/admin"
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@using Perezosoft.Shared.Ui.Auth
@inject AuthService Auth
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["Admin_Title"]</PageTitle>

<div class="admin-wrapper">
    <h1 class="h4 fw-bold mb-1">@Localizer["Admin_Title"]</h1>
    <p class="text-muted mb-4">@Localizer["Admin_Subtitle"]</p>

    @if (_state == State.Loading)
    {
        <div class="p-4 text-center text-muted">
            <span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Common_Loading"]
        </div>
    }
    else if (_state == State.Forbidden)
    {
        <div class="alert alert-danger" data-testid="admin-forbidden">
            @Localizer["Admin_Forbidden"]
            <a href="/" class="alert-link ms-1">@Localizer["Admin_BackHome"]</a>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger py-2">@_error</div>
        }

        @* ── Platform-wide broadcast (ADMIN-3): queued on the outbox, delivered out-of-band.
             Opinionated template feature — rebranders can remove this card. ── *@
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h2 class="h6 fw-bold mb-1">@Localizer["Admin_BroadcastTitle"]</h2>
                <p class="small text-muted mb-2">@Localizer["Admin_BroadcastHint"]</p>
                @if (!string.IsNullOrEmpty(_broadcastStatus))
                {
                    <div class="alert alert-success py-2" data-testid="admin-broadcast-status">@_broadcastStatus</div>
                }
                <div class="row g-2 align-items-start">
                    <div class="col-12 col-md-4">
                        <input class="form-control" maxlength="200" data-testid="admin-broadcast-title"
                               placeholder="@Localizer["Admin_AnnounceTitlePlaceholder"]" @bind="_broadcastTitle" />
                    </div>
                    <div class="col-12 col-md-6">
                        <textarea class="form-control" rows="1" maxlength="2000" data-testid="admin-broadcast-body"
                                  placeholder="@Localizer["Admin_AnnounceBodyPlaceholder"]" @bind="_broadcastBody"></textarea>
                    </div>
                    <div class="col-12 col-md-2 d-grid">
                        <button class="btn btn-outline-danger btn-sm" data-testid="admin-broadcast-send"
                                disabled="@(_busy || string.IsNullOrWhiteSpace(_broadcastTitle) || string.IsNullOrWhiteSpace(_broadcastBody))"
                                @onclick="SendBroadcast">@Localizer["Admin_BroadcastSend"]</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            @* ── Tenant list ── *@
            <div class="col-12 col-lg-5">
                <div class="card shadow-sm">
                    <div class="card-header py-2 fw-semibold small">
                        @Localizer["Admin_TenantsTitle"] <span class="text-muted">(@_tenants.Count)</span>
                    </div>
                    <div class="list-group list-group-flush" style="max-height:60vh;overflow-y:auto">
                        @foreach (var t in _tenants)
                        {
                            <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(t.Id == _selectedId ? "active" : "")"
                                    data-testid="admin-tenant-row" @onclick="() => SelectTenant(t.Id)">
                                <span class="text-truncate">@t.Name</span>
                                <span class="badge bg-secondary-subtle text-secondary-emphasis ms-2">@t.MemberCount</span>
                            </button>
                        }
                        @if (_tenants.Count == 0)
                        {
                            <div class="list-group-item text-muted small">@Localizer["Admin_NoTenants"]</div>
                        }
                    </div>
                </div>
            </div>

            @* ── Tenant detail ── *@
            <div class="col-12 col-lg-7">
                @if (_detailLoading)
                {
                    <div class="p-4 text-center text-muted">
                        <span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Common_Loading"]
                    </div>
                }
                else if (_detail is not null)
                {
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h2 class="h6 fw-bold mb-1">@_detail.Name</h2>
                                    <div class="text-muted small">@_detail.Id</div>
                                </div>
                                <span>
                                    <span class="badge bg-primary-subtle text-primary-emphasis" data-testid="admin-plan">@_detail.PlanKey</span>
                                    <span class="badge bg-info-subtle text-info-emphasis">@_detail.SubscriptionStatus</span>
                                </span>
                            </div>

                            <dl class="row small mb-3">
                                <dt class="col-5 text-muted fw-normal">@Localizer["Admin_Created"]</dt>
                                <dd class="col-7">@_detail.CreatedAt.LocalDateTime.ToString("g")</dd>
                                <dt class="col-5 text-muted fw-normal">@Localizer["Admin_AuditEvents"]</dt>
                                <dd class="col-7">@_detail.AuditEventCount</dd>
                            </dl>

                            @* ── Staff plan override (comp). The server refuses provider-managed subs (409). ── *@
                            <h3 class="h6 fw-semibold mb-2">@Localizer["Admin_SubscriptionTitle"]</h3>
                            @if (!string.IsNullOrEmpty(_subscriptionMsg))
                            {
                                <div class="alert alert-success py-2" data-testid="admin-sub-status">@_subscriptionMsg</div>
                            }
                            @if (_detail.ProviderManaged)
                            {
                                <p class="small text-muted mb-3">@Localizer["Admin_ProviderManaged"]</p>
                            }
                            else
                            {
                                <div class="d-flex gap-2 mb-3">
                                    @if (_detail.PlanKey != "pro")
                                    {
                                        <button class="btn btn-outline-primary btn-sm" data-testid="admin-comp-pro"
                                                disabled="@_busy" @onclick="CompPro">@Localizer["Admin_CompPro"]</button>
                                    }
                                    @if (_detail.PlanKey != "free")
                                    {
                                        <button class="btn btn-outline-danger btn-sm" data-testid="admin-revert-free"
                                                disabled="@_busy" @onclick="RevertFree">@Localizer["Admin_RevertFree"]</button>
                                    }
                                </div>
                            }

                            <h3 class="h6 fw-semibold mb-2">@Localizer["Admin_Members"] <span class="text-muted">(@_detail.Members.Count)</span></h3>
                            @if (!string.IsNullOrEmpty(_mfaResetMsg))
                            {
                                <div class="alert alert-success py-2" data-testid="admin-mfa-reset-status">@_mfaResetMsg</div>
                            }
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr class="small text-muted">
                                            <th style="width:1.75rem"></th>
                                            <th>@Localizer["Admin_ColMember"]</th>
                                            <th>@Localizer["Admin_ColRole"]</th>
                                            <th class="text-end"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var m in _detail.Members)
                                        {
                                            <tr>
                                                <td>
                                                    @* Target this member in the announcement below (none checked = all members). *@
                                                    <input type="checkbox" class="form-check-input" data-testid="admin-member-check"
                                                           checked="@_selectedMembers.Contains(m.UserId)"
                                                           @onchange="e => ToggleMember(m.UserId, (bool)e.Value!)" />
                                                </td>
                                                <td>
                                                    <div class="fw-medium small">@(string.IsNullOrEmpty(m.DisplayName) ? m.Email : m.DisplayName)</div>
                                                    @if (!string.IsNullOrEmpty(m.DisplayName))
                                                    {
                                                        <div class="text-muted" style="font-size:.75rem">@m.Email</div>
                                                    }
                                                </td>
                                                <td><span class="badge bg-light text-dark border">@m.Role</span></td>
                                                <td class="text-end text-nowrap">
                                                    <button class="btn btn-outline-warning btn-sm" disabled="@_busy"
                                                            @onclick="() => Impersonate(m)">
                                                        @Localizer["Admin_Impersonate"]
                                                    </button>
                                                    @* Staff recovery for a locked-out user (ADR-021 addendum): wipes their
                                                       authenticator + recovery codes after out-of-band identity verification. *@
                                                    <button class="btn btn-outline-danger btn-sm ms-1" disabled="@_busy"
                                                            data-testid="admin-mfa-reset" @onclick="() => ResetMfa(m)">
                                                        @Localizer["Admin_ResetMfa"]
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            @* ── Announcement to all members (ADMIN-3) ── *@
                            <h3 class="h6 fw-semibold mt-4 mb-2">@Localizer["Admin_AnnounceTitle"]</h3>
                            @if (!string.IsNullOrEmpty(_announceStatus))
                            {
                                <div class="alert alert-success py-2" data-testid="admin-status">@_announceStatus</div>
                            }
                            <div class="mb-2">
                                <input class="form-control" maxlength="200" data-testid="admin-announce-title"
                                       placeholder="@Localizer["Admin_AnnounceTitlePlaceholder"]" @bind="_announceTitle" />
                            </div>
                            <div class="mb-2">
                                <textarea class="form-control" rows="3" maxlength="2000" data-testid="admin-announce-body"
                                          placeholder="@Localizer["Admin_AnnounceBodyPlaceholder"]" @bind="_announceBody"></textarea>
                            </div>
                            <button class="btn btn-outline-primary btn-sm" data-testid="admin-announce-send"
                                    disabled="@(_busy || string.IsNullOrWhiteSpace(_announceTitle) || string.IsNullOrWhiteSpace(_announceBody))"
                                    @onclick="SendAnnouncement">
                                @(_selectedMembers.Count > 0
                                    ? Localizer["Admin_AnnounceSendSelected", _selectedMembers.Count]
                                    : Localizer["Admin_AnnounceSend"])
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-muted p-4 text-center border rounded">@Localizer["Admin_SelectTenant"]</div>
                }
            </div>
        </div>
    }
</div>

@code {
    private enum State { Loading, Forbidden, Ready }

    private State _state = State.Loading;
    private bool _busy;
    private bool _detailLoading;
    private string? _error;
    private List<TenantSummaryDto> _tenants = new();
    private Guid? _selectedId;
    private TenantDetailDto? _detail;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login"); return; }
        if (!await Auth.IsStaffAsync()) { _state = State.Forbidden; return; }
        await LoadTenants();
        _state = State.Ready;
    }

    private async Task LoadTenants()
    {
        try
        {
            _tenants = await Http.GetFromJsonAsync<List<TenantSummaryDto>>("/api/admin/tenants") ?? new();
        }
        catch { _error = Localizer["Admin_ErrLoad"]; }
    }

    private async Task SelectTenant(Guid id)
    {
        _selectedId = id;
        _detail = null;
        _detailLoading = true;
        _error = null;
        _announceStatus = null;
        _subscriptionMsg = null;
        _mfaResetMsg = null;
        _selectedMembers.Clear();
        try
        {
            _detail = await Http.GetFromJsonAsync<TenantDetailDto>($"/api/admin/tenants/{id}");
        }
        catch { _error = Localizer["Admin_ErrDetail"]; }
        finally { _detailLoading = false; }
    }

    private async Task Impersonate(MemberDto m)
    {
        var name = string.IsNullOrEmpty(m.DisplayName) ? m.Email : m.DisplayName;
        if (!await JS.ConfirmAsync(Localizer["Admin_ConfirmImpersonate", name])) return;

        _busy = true; _error = null;
        try
        {
            var res = await Http.PostAsync($"/api/admin/impersonate/{m.UserId}", null);
            if (res.IsSuccessStatusCode)
            {
                var body = await res.Content.ReadFromJsonAsync<ImpersonationDto>();
                if (!string.IsNullOrEmpty(body?.AccessToken))
                {
                    // Swap the in-memory session to the short-lived impersonation token, then hand off
                    // to the app as that user (client-side nav keeps the token; a reload would restore staff).
                    Auth.BeginImpersonation(body.AccessToken);
                    Nav.NavigateTo("/");
                    return;
                }
            }
            _error = Localizer["Admin_ErrImpersonate"];
        }
        catch { _error = Localizer["Admin_ErrImpersonate"]; }
        finally { _busy = false; }
    }

    private string _announceTitle = "";
    private string _announceBody = "";
    private string? _announceStatus;
    private string? _subscriptionMsg;
    private string? _mfaResetMsg;

    private async Task ResetMfa(MemberDto m)
    {
        var name = string.IsNullOrEmpty(m.DisplayName) ? m.Email : m.DisplayName;
        if (!await JS.ConfirmAsync(Localizer["Admin_ConfirmResetMfa", name])) return;

        _busy = true; _mfaResetMsg = null; _error = null;
        try
        {
            var res = await Http.DeleteAsync($"/api/admin/users/{m.UserId}/mfa");
            if (res.IsSuccessStatusCode) _mfaResetMsg = Localizer["Admin_MfaWasReset", name];
            else _error = Localizer["Admin_ErrResetMfa"];
        }
        catch { _error = Localizer["Admin_ErrResetMfa"]; }
        finally { _busy = false; }
    }

    private async Task CompPro()
    {
        if (_detail is null) return;
        if (!await JS.ConfirmAsync(Localizer["Admin_ConfirmComp", _detail.Name])) return;

        _busy = true; _subscriptionMsg = null; _error = null;
        try
        {
            var res = await Http.PutAsJsonAsync($"/api/admin/tenants/{_detail.Id}/subscription", new { plan_key = "pro" });
            if (res.IsSuccessStatusCode)
            {
                _subscriptionMsg = Localizer["Admin_SubscriptionUpdated"];
                await ReloadDetail();
            }
            else { _error = Localizer["Admin_ErrSubscription"]; }
        }
        catch { _error = Localizer["Admin_ErrSubscription"]; }
        finally { _busy = false; }
    }

    private async Task RevertFree()
    {
        if (_detail is null) return;
        if (!await JS.ConfirmAsync(Localizer["Admin_ConfirmRevert", _detail.Name])) return;

        _busy = true; _subscriptionMsg = null; _error = null;
        try
        {
            var res = await Http.DeleteAsync($"/api/admin/tenants/{_detail.Id}/subscription");
            if (res.IsSuccessStatusCode)
            {
                _subscriptionMsg = Localizer["Admin_SubscriptionUpdated"];
                await ReloadDetail();
            }
            else { _error = Localizer["Admin_ErrSubscription"]; }
        }
        catch { _error = Localizer["Admin_ErrSubscription"]; }
        finally { _busy = false; }
    }

    // Re-fetch the open tenant so the plan badge/buttons reflect the change (keeps _subscriptionMsg).
    private async Task ReloadDetail()
    {
        if (_selectedId is not { } id) return;
        try { _detail = await Http.GetFromJsonAsync<TenantDetailDto>($"/api/admin/tenants/{id}"); }
        catch { /* detail stays; next select refreshes */ }
    }

    // Member targeting: checked rows become the announce recipients; none checked = all members.
    private readonly HashSet<Guid> _selectedMembers = new();

    private void ToggleMember(Guid userId, bool selected)
    {
        if (selected) _selectedMembers.Add(userId);
        else _selectedMembers.Remove(userId);
    }

    private async Task SendAnnouncement()
    {
        if (_detail is null) return;
        var confirm = _selectedMembers.Count > 0
            ? Localizer["Admin_ConfirmAnnounceSelected", _selectedMembers.Count, _detail.Name]
            : Localizer["Admin_ConfirmAnnounce", _detail.Name];
        if (!await JS.ConfirmAsync(confirm)) return;

        _busy = true; _announceStatus = null; _error = null;
        try
        {
            var res = await Http.PostAsJsonAsync($"/api/admin/tenants/{_detail.Id}/announce",
                new
                {
                    title = _announceTitle.Trim(),
                    body = _announceBody.Trim(),
                    user_ids = _selectedMembers.Count > 0 ? _selectedMembers.ToArray() : null,
                });
            if (res.IsSuccessStatusCode)
            {
                var body = await res.Content.ReadFromJsonAsync<AnnounceResultDto>();
                _announceStatus = Localizer["Admin_AnnounceSent", body?.NotifiedCount ?? 0];
                _announceTitle = "";
                _announceBody = "";
                _selectedMembers.Clear();
            }
            else { _error = Localizer["Admin_ErrAnnounce"]; }
        }
        catch { _error = Localizer["Admin_ErrAnnounce"]; }
        finally { _busy = false; }
    }

    private string _broadcastTitle = "";
    private string _broadcastBody = "";
    private string? _broadcastStatus;

    private async Task SendBroadcast()
    {
        if (!await JS.ConfirmAsync(Localizer["Admin_ConfirmBroadcast"])) return;

        _busy = true; _broadcastStatus = null; _error = null;
        try
        {
            var res = await Http.PostAsJsonAsync("/api/admin/announce-all",
                new { title = _broadcastTitle.Trim(), body = _broadcastBody.Trim() });
            if (res.IsSuccessStatusCode) // 202: queued on the outbox, delivered out-of-band
            {
                _broadcastStatus = Localizer["Admin_BroadcastQueued"];
                _broadcastTitle = "";
                _broadcastBody = "";
            }
            else { _error = Localizer["Admin_ErrBroadcast"]; }
        }
        catch { _error = Localizer["Admin_ErrBroadcast"]; }
        finally { _busy = false; }
    }

    private sealed record AnnounceResultDto
    {
        [JsonPropertyName("notified_count")] public int NotifiedCount { get; init; }
    }

    private sealed record TenantSummaryDto
    {
        [JsonPropertyName("id")] public Guid Id { get; init; }
        [JsonPropertyName("name")] public string Name { get; init; } = string.Empty;
        [JsonPropertyName("member_count")] public int MemberCount { get; init; }
        [JsonPropertyName("created_at")] public DateTimeOffset CreatedAt { get; init; }
    }

    private sealed record TenantDetailDto
    {
        [JsonPropertyName("id")] public Guid Id { get; init; }
        [JsonPropertyName("name")] public string Name { get; init; } = string.Empty;
        [JsonPropertyName("created_at")] public DateTimeOffset CreatedAt { get; init; }
        [JsonPropertyName("members")] public List<MemberDto> Members { get; init; } = new();
        [JsonPropertyName("subscription_status")] public string SubscriptionStatus { get; init; } = string.Empty;
        [JsonPropertyName("plan_key")] public string PlanKey { get; init; } = string.Empty;
        [JsonPropertyName("provider_managed")] public bool ProviderManaged { get; init; }
        [JsonPropertyName("audit_event_count")] public int AuditEventCount { get; init; }
    }

    private sealed record MemberDto
    {
        [JsonPropertyName("user_id")] public Guid UserId { get; init; }
        [JsonPropertyName("display_name")] public string? DisplayName { get; init; }
        [JsonPropertyName("email")] public string Email { get; init; } = string.Empty;
        [JsonPropertyName("role")] public string Role { get; init; } = string.Empty;
    }

    private sealed record ImpersonationDto
    {
        [JsonPropertyName("access_token")] public string? AccessToken { get; init; }
        [JsonPropertyName("expires_in")] public int ExpiresIn { get; init; }
    }
}
