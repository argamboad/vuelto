@inject IStringLocalizer<AppStrings> Localizer

@* ₡ · $ · both — the "show amounts in" control (MoneyDisplay). Charts can draw one currency only, so they hide "both".
   The same rail track as SegmentedSwitch (SKIN-11), so the two segmented controls read as one pattern; buttons
   rather than radios because the choice persists to the account and is not a form value, and aria-pressed
   says which one is on. *@
<div class="cur">
    @if (Label is not null)
    {
        <span class="cur-label" id="@(TestId + "-label")">@Label</span>
    }
    <div class="cur-track" role="group" aria-labelledby="@(Label is null ? null : TestId + "-label")" aria-label="@(Label is null ? Localizer["Reports_ShowIn"].Value : null)">
        <button type="button" class="cur-option" aria-pressed="@Pressed(MoneyDisplay.Crc)" data-testid="@(TestId + "-crc")" @onclick='() => PickAsync(MoneyDisplay.Crc)'>₡</button>
        <button type="button" class="cur-option" aria-pressed="@Pressed(MoneyDisplay.Usd)" data-testid="@(TestId + "-usd")" @onclick='() => PickAsync(MoneyDisplay.Usd)'>$</button>
        @if (AllowBoth)
        {
            <button type="button" class="cur-option" aria-pressed="@Pressed(MoneyDisplay.Both)" data-testid="@(TestId + "-both")" @onclick='() => PickAsync(MoneyDisplay.Both)'>@Localizer["Cur_Both"]</button>
        }
    </div>
</div>

@code {
    [Parameter] public string Value { get; set; } = MoneyDisplay.Both;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool AllowBoth { get; set; } = true;
    [Parameter] public string TestId { get; set; } = "cur";
    [Parameter] public string? Label { get; set; }

    private string Pressed(string value) => Value == value ? "true" : "false";
    private Task PickAsync(string value) => ValueChanged.InvokeAsync(value);
}
