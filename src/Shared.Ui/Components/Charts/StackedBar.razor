@using System.Globalization
@inject IStringLocalizer<AppStrings> Localizer

@* One bar whose full width is a total (income) filled left to right by ordered segments — inline SVG, no JS,
   theme-aware through Bootstrap tokens. When the segments add up to MORE than the total, the bar keeps its
   proportions but the part past the total is painted red (the shortfall). An optional marker (today) sits at a
   fraction of the total. One currency per bar; the legend carries label + amount + share of the total. *@
<div class="chart-stacked" data-testid="@TestId">
    @if (Total <= 0 && Segments.All(s => s.Value <= 0))
    {
        <p class="text-muted small mb-0">@Localizer["Chart_Empty"]</p>
    }
    else
    {
        var sum = Segments.Sum(s => Math.Max(s.Value, 0));
        var scale = Math.Max(Math.Max(Total, sum), 0.01m);
        var over = sum - Total;
        var markerX = Marker is { } m ? X(Math.Clamp(m, 0m, 1m) * Total, scale) : null;
        <svg viewBox="0 0 @Width @Height" role="img" aria-label="@Title" style="font: 11px var(--bs-body-font-family); display: block; width: 100%; height: auto;">
            <title>@Title</title>
            <rect x="0" y="@Top" width="@Width" height="@BarH" rx="4" fill="var(--bs-secondary-bg)" />
            @{ decimal at = 0; }
            @foreach (var s in Segments.Where(s => s.Value > 0))
            {
                var x = X(at, scale); var w = X(s.Value, scale);
                <rect x="@x" y="@Top" width="@w" height="@BarH" fill="@s.CssColor" data-testid="chart-segment" data-label="@s.Label"><title>@s.Label · @Format(s.Value)</title></rect>
                at += s.Value;
            }
            @if (over > 0)
            {
                <rect x="@X(Total, scale)" y="@Top" width="@X(over, scale)" height="@BarH" fill="var(--bs-danger)" opacity="0.85" data-testid="chart-overflow"><title>@OverLabel · @Format(over)</title></rect>
                <line x1="@X(Total, scale)" y1="@(Top - 4)" x2="@X(Total, scale)" y2="@(Top + BarH + 4)" stroke="var(--bs-body-color)" stroke-width="1.5" />
            }
            @* Razor reserves <text> inside code blocks, so the marker is a markup-only group toggled by display. *@
            <g display="@(markerX is null ? "none" : "inline")">
                <line x1="@markerX" y1="@(Top - 6)" x2="@markerX" y2="@(Top + BarH + 6)" stroke="var(--bs-warning)" stroke-width="1.5" stroke-dasharray="3 3" data-testid="@(markerX is null ? null : "chart-marker")" />
                <text x="@markerX" y="@(Top - 9)" text-anchor="middle" fill="var(--bs-warning)">@(MarkerLabel ?? Localizer["Chart_Today"].Value)</text>
            </g>
        </svg>
        <ul class="list-unstyled small mb-0 d-flex flex-wrap gap-3 mt-1" data-testid="chart-legend">
            @foreach (var s in Segments)
            {
                <li class="d-flex align-items-center gap-1" data-testid="chart-legend-item">
                    <span class="d-inline-block rounded-1" style="width: 10px; height: 10px; background: @s.CssColor; flex: none;"></span>
                    <span>@s.Label</span>
                    <span class="text-muted">@Format(s.Value)@(Total > 0 ? " · " + (s.Value / Total).ToString("P0", CultureInfo.CurrentCulture) : "")</span>
                </li>
            }
            @if (over > 0)
            {
                <li class="d-flex align-items-center gap-1 text-danger" data-testid="chart-legend-over">
                    <span class="d-inline-block rounded-1" style="width: 10px; height: 10px; background: var(--bs-danger); flex: none;"></span>
                    <span>@OverLabel</span>
                    <span>@Format(over)</span>
                </li>
            }
        </ul>
    }
</div>

@code {
    /// <summary>The full width of the bar — what the segments are measured against (income).</summary>
    [Parameter, EditorRequired] public decimal Total { get; set; }
    /// <summary>Ordered left-to-right; zero or negative values are listed in the legend but draw nothing.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<DonutSlice> Segments { get; set; } = [];
    /// <summary>A position along the total, 0–1 (e.g. the share of the month elapsed); null draws no marker.</summary>
    [Parameter] public decimal? Marker { get; set; }
    [Parameter] public string? MarkerLabel { get; set; }
    /// <summary>Legend word for the part past the total.</summary>
    [Parameter] public string OverLabel { get; set; } = "";
    [Parameter] public string Currency { get; set; } = "CRC";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string TestId { get; set; } = "chart";

    private const int Width = 640, Height = 46, Top = 16, BarH = 22;

    private static string X(decimal value, decimal scale) => ((double)(Width * Math.Max(value, 0) / scale)).ToString("0.##", CultureInfo.InvariantCulture);

    private string Format(decimal value) => (Currency == "USD" ? "$" : "₡") + value.ToString("N0", CultureInfo.CurrentCulture);
}
