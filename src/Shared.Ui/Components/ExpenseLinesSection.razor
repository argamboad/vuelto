@using System.Globalization
@using System.Net
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@inject HttpClient Http
@inject IStringLocalizer<AppStrings> Localizer

@* One budget-line list (fixed or variable — EXPENSES-1, ADR-V007/V008): ordered rows with move up/down,
   an inline create/edit form (single-currency budget, method, required category, optional bank, active
   toggle) and the inactive-name-clash reactivation offer. *@
<section class="mb-4" data-testid="@($"exp-{Kind}")">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
        <h2 class="h5 fw-bold mb-0">@Localizer[TitleKey]</h2>
        <button class="btn btn-primary btn-sm" data-testid="exp-new" disabled="@(_form is not null)" @onclick="OpenNew">@Localizer[NewKey]</button>
    </div>

    @if (_notice is not null)
    {
        <div class="alert alert-success py-2" data-testid="exp-notice">@_notice</div>
    }
    @if (_error is not null)
    {
        <div class="alert alert-danger py-2" data-testid="exp-error">@_error</div>
    }

    @if (_form is not null)
    {
        <div class="card shadow-sm mb-3" data-testid="exp-form">
            <div class="card-body">
                <h3 class="h6 fw-bold mb-3">@(_form.Editing is null ? Localizer["Budget_NewLine"] : Localizer["Budget_EditLine"])</h3>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label small fw-medium mb-1" for="exp-name-@Kind">@Localizer["Catalog_Name"]</label>
                        <input class="form-control" id="exp-name-@Kind" data-testid="exp-name" maxlength="100" disabled="@_saving" @bind="_form.Name" @bind:event="oninput" />
                    </div>
                    <div class="col-8 col-md-4">
                        <label class="form-label small fw-medium mb-1" for="exp-amount-@Kind">@Localizer["Budget_Amount"]</label>
                        <input class="form-control" type="number" step="0.01" min="0" id="exp-amount-@Kind" data-testid="exp-amount" disabled="@_saving" @bind="_form.Amount" />
                    </div>
                    <div class="col-4 col-md-2">
                        <label class="form-label small fw-medium mb-1" for="exp-currency-@Kind">@Localizer["Tx_Currency"]</label>
                        <select class="form-select" id="exp-currency-@Kind" data-testid="exp-currency" disabled="@_saving" @bind="_form.Currency"><option>CRC</option><option>USD</option></select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label small fw-medium mb-1" for="exp-category-@Kind">@Localizer["Tx_Category"]</label>
                        <select class="form-select" id="exp-category-@Kind" data-testid="exp-category" disabled="@_saving" @bind="_form.CategoryId">
                            <option value="">—</option>
                            @foreach (var c in Categories) { <option value="@c.Id">@c.Name</option> }
                        </select>
                        <div class="form-text">@Localizer["Budget_CategoryHint"]</div>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label small fw-medium mb-1" for="exp-bank-@Kind">@Localizer["Tx_Bank"]</label>
                        <select class="form-select" id="exp-bank-@Kind" data-testid="exp-bank" disabled="@_saving" @bind="_form.BankId">
                            <option value="">@Localizer["Budget_Unassigned"]</option>
                            @foreach (var b in Banks) { <option value="@b.Id">@b.Name</option> }
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label small fw-medium mb-1" for="exp-method-@Kind">@Localizer["Tx_PaymentMethod"]</label>
                        <select class="form-select" id="exp-method-@Kind" data-testid="exp-method" disabled="@_saving" @bind="_form.Method">
                            <option value="credit_card">@Localizer["Tx_CreditCard"]</option>
                            <option value="bank_account">@Localizer["Tx_BankAccount"]</option>
                        </select>
                    </div>
                    @if (_form.Editing is not null)
                    {
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="exp-active-@Kind" data-testid="exp-active" disabled="@_saving" @bind="_form.IsActive" />
                                <label class="form-check-label" for="exp-active-@Kind">@Localizer["Budget_ActiveToggle"]</label>
                            </div>
                        </div>
                    }
                </div>

                @if (_form.Conflict is not null)
                {
                    <div class="alert alert-warning py-2 mt-3 d-flex align-items-center justify-content-between gap-2" data-testid="exp-conflict">
                        <span>@_form.Conflict.Message</span>
                        <button class="btn btn-warning btn-sm" data-testid="exp-reactivate" disabled="@_saving" @onclick="Reactivate">@Localizer["Catalog_Reactivate"]</button>
                    </div>
                }
                else if (_form.Error is not null)
                {
                    <div class="alert alert-danger py-2 mt-3" data-testid="exp-form-error">@_form.Error</div>
                }

                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-primary" data-testid="exp-save" disabled="@_saving" @onclick="Save">@(_saving ? Localizer["Catalog_Saving"] : _form.Editing is null ? Localizer["Catalog_Create"] : Localizer["Catalog_Save"])</button>
                    <button class="btn btn-outline-secondary" data-testid="exp-cancel" disabled="@_saving" @onclick="() => _form = null">@Localizer["Catalog_Cancel"]</button>
                </div>
            </div>
        </div>
    }

    @if (_loading)
    {
        <div class="text-muted"><span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Common_Loading"]</div>
    }
    else if (_items.Count == 0)
    {
        <p class="text-muted" data-testid="exp-empty">@Localizer["Budget_Empty"]</p>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" data-testid="exp-table">
                    <thead>
                        <tr>
                            <th scope="col" style="width:5rem"></th>
                            <th scope="col">@Localizer["Catalog_Name"]</th>
                            <th scope="col" class="text-end">@Localizer["Budget_Amount"]</th>
                            <th scope="col">@Localizer["Tx_Category"]</th>
                            <th scope="col">@Localizer["Tx_Bank"]</th>
                            <th scope="col">@Localizer["Tx_PaymentMethod"]</th>
                            <th scope="col">@Localizer["Catalog_Status"]</th>
                            <th scope="col" class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var active = _items.Where(i => i.IsActive).ToList(); }
                        @foreach (var item in _items)
                        {
                            var idx = active.IndexOf(item);
                            <tr data-testid="exp-row" class="@(item.IsActive ? null : "text-muted")">
                                <td class="text-nowrap">
                                    @if (item.IsActive)
                                    {
                                        <button class="btn btn-outline-secondary btn-sm px-2" data-testid="exp-up" aria-label="Move up" disabled="@(idx <= 0 || _saving)" @onclick="() => MoveAsync(item, -1)">▲</button>
                                        <button class="btn btn-outline-secondary btn-sm px-2" data-testid="exp-down" aria-label="Move down" disabled="@(idx >= active.Count - 1 || _saving)" @onclick="() => MoveAsync(item, +1)">▼</button>
                                    }
                                </td>
                                <td data-testid="exp-row-name">@item.Name</td>
                                <td class="text-end" data-testid="exp-row-budget">@(item.BudgetCrc > 0 ? $"₡{item.BudgetCrc.ToString("N2", CultureInfo.CurrentCulture)}" : $"${item.BudgetUsd.ToString("N2", CultureInfo.CurrentCulture)}")</td>
                                <td>@(Categories.FirstOrDefault(c => c.Id == item.CategoryId)?.Name ?? "—")</td>
                                <td>@(item.BankId is { } b ? Banks.FirstOrDefault(x => x.Id == b)?.Name ?? "—" : Localizer["Budget_Unassigned"])</td>
                                <td>@(item.PaymentMethod == "bank_account" ? Localizer["Tx_BankAccount"] : Localizer["Tx_CreditCard"])</td>
                                <td>
                                    <span class="badge @(item.IsActive ? "bg-success-subtle text-success-emphasis" : "bg-secondary-subtle text-secondary-emphasis")">
                                        @(item.IsActive ? Localizer["Catalog_Active"] : Localizer["Catalog_Inactive"])
                                    </span>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm" data-testid="exp-edit" disabled="@(_form is not null)" @onclick="() => OpenEdit(item)">@Localizer["Catalog_Edit"]</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>

@code {
    /// <summary><c>fixed</c> or <c>variable</c> — selects the API list.</summary>
    [Parameter, EditorRequired] public string Kind { get; set; } = "fixed";
    [Parameter, EditorRequired] public string TitleKey { get; set; } = "";
    [Parameter, EditorRequired] public string NewKey { get; set; } = "";
    /// <summary>Active categories and banks (all states) the page loaded once for both lists.</summary>
    [Parameter] public IReadOnlyList<NamedItem> Categories { get; set; } = [];
    [Parameter] public IReadOnlyList<NamedItem> Banks { get; set; } = [];

    public sealed record NamedItem([property: JsonPropertyName("id")] Guid Id, [property: JsonPropertyName("name")] string Name, [property: JsonPropertyName("is_active")] bool IsActive);

    private string Endpoint => $"/api/expenses/{Kind}";
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private string? _notice;
    private List<LineDto> _items = new();
    private FormState? _form;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try { _items = await Http.GetFromJsonAsync<List<LineDto>>($"{Endpoint}?include_inactive=true") ?? new(); }
        catch { _error = Localizer["Budget_LoadError"]; }
        finally { _loading = false; }
    }

    private void OpenNew() { _notice = null; _form = new FormState(null, "", 0m, "CRC", "", "", "credit_card", true); }

    private void OpenEdit(LineDto item)
    {
        _notice = null;
        var crc = item.BudgetCrc > 0;
        _form = new FormState(item, item.Name, crc ? item.BudgetCrc : item.BudgetUsd, crc ? "CRC" : "USD", item.CategoryId.ToString(), item.BankId?.ToString() ?? "", item.PaymentMethod, item.IsActive);
    }

    private static object Payload(FormState f, string name, bool isActive) => new
    {
        name,
        budget_crc = f.Currency == "CRC" ? f.Amount : 0m,
        budget_usd = f.Currency == "USD" ? f.Amount : 0m,
        payment_method = f.Method,
        category_id = f.CategoryId,
        bank_id = f.BankId == "" ? null : f.BankId,
        is_active = isActive,
    };

    private async Task Save()
    {
        if (_form is not { } form) return;
        form.Error = null; form.Conflict = null;
        if (string.IsNullOrWhiteSpace(form.Name)) { form.Error = Localizer["Catalog_NameRequired"]; return; }
        if (form.Amount <= 0) { form.Error = Localizer["Budget_AmountRequired"]; return; }
        if (form.CategoryId == "") { form.Error = Localizer["Tx_Validation_Category"]; return; }

        _saving = true;
        try
        {
            var res = form.Editing is null
                ? await Http.PostAsJsonAsync(Endpoint, Payload(form, form.Name, true))
                : await Http.PutAsJsonAsync($"{Endpoint}/{form.Editing.Id}", Payload(form, form.Name, form.IsActive));
            if (res.IsSuccessStatusCode) { _notice = form.Editing is null ? Localizer["Catalog_Saved"] : Localizer["Catalog_Updated"]; _form = null; await LoadAsync(); }
            else if (res.StatusCode == HttpStatusCode.Conflict)
            {
                var conflict = await res.Content.ReadFromJsonAsync<ConflictDto>();
                if (conflict?.ExistingId is not null) form.Conflict = conflict; else form.Error = conflict?.Message ?? Localizer["Catalog_NameExists"];
            }
            else form.Error = (await res.Content.ReadFromJsonAsync<ConflictDto>())?.Message ?? Localizer["Catalog_SaveError"];
        }
        catch { form.Error = Localizer["Catalog_SaveError"]; }
        finally { _saving = false; }
    }

    /// <summary>Restores the inactive line under its stored name, with the budget/category/bank just typed.</summary>
    private async Task Reactivate()
    {
        if (_form is not { Conflict: { ExistingId: { } id } conflict } form) return;
        _saving = true;
        try
        {
            var res = await Http.PutAsJsonAsync($"{Endpoint}/{id}", Payload(form, conflict.ExistingName ?? form.Name, true));
            if (res.IsSuccessStatusCode) { _notice = Localizer["Catalog_Updated"]; _form = null; await LoadAsync(); }
            else { form.Conflict = null; form.Error = (await res.Content.ReadFromJsonAsync<ConflictDto>())?.Message ?? Localizer["Catalog_ReactivateError"]; }
        }
        catch { form.Conflict = null; form.Error = Localizer["Catalog_ReactivateError"]; }
        finally { _saving = false; }
    }

    /// <summary>Swaps the line with its active neighbour and PUTs the whole active order (the API requires the exact active set).</summary>
    private async Task MoveAsync(LineDto item, int delta)
    {
        var active = _items.Where(i => i.IsActive).Select(i => i.Id).ToList();
        var idx = active.IndexOf(item.Id);
        var target = idx + delta;
        if (idx < 0 || target < 0 || target >= active.Count) return;
        (active[idx], active[target]) = (active[target], active[idx]);

        _saving = true; _error = null;
        try
        {
            var res = await Http.PutAsJsonAsync($"{Endpoint}/order", new { ordered_ids = active });
            if (!res.IsSuccessStatusCode) _error = Localizer["Budget_ReorderError"];
            await LoadAsync();
        }
        catch { _error = Localizer["Budget_ReorderError"]; }
        finally { _saving = false; }
    }

    private sealed class FormState(LineDto? editing, string name, decimal amount, string currency, string categoryId, string bankId, string method, bool isActive)
    {
        public LineDto? Editing { get; } = editing;
        public string Name { get; set; } = name;
        public decimal Amount { get; set; } = amount;
        public string Currency { get; set; } = currency;
        public string CategoryId { get; set; } = categoryId;
        public string BankId { get; set; } = bankId;
        public string Method { get; set; } = method;
        public bool IsActive { get; set; } = isActive;
        public string? Error { get; set; }
        public ConflictDto? Conflict { get; set; }
    }

    private sealed record LineDto(
        [property: JsonPropertyName("id")] Guid Id,
        [property: JsonPropertyName("name")] string Name,
        [property: JsonPropertyName("budget_crc")] decimal BudgetCrc,
        [property: JsonPropertyName("budget_usd")] decimal BudgetUsd,
        [property: JsonPropertyName("payment_method")] string PaymentMethod,
        [property: JsonPropertyName("category_id")] Guid CategoryId,
        [property: JsonPropertyName("bank_id")] Guid? BankId,
        [property: JsonPropertyName("sort_order")] int SortOrder,
        [property: JsonPropertyName("is_active")] bool IsActive);

    private sealed record ConflictDto(
        [property: JsonPropertyName("error")] string Error,
        [property: JsonPropertyName("message")] string Message,
        [property: JsonPropertyName("existing_id")] Guid? ExistingId,
        [property: JsonPropertyName("existing_name")] string? ExistingName);
}
