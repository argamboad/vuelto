@using System.Net
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@inject HttpClient Http
@inject IJSRuntime JS
@inject IStringLocalizer<AppStrings> Localizer

@* ── Two-factor authentication (authenticator TOTP — MFA-1, ADR-012) ── *@
<div class="card shadow-sm mt-4">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <h2 class="h6 fw-bold mb-0">@Localizer["Mfa_Title"]</h2>
            @if (_state == State.On)
            {
                <span class="badge bg-success-subtle text-success-emphasis" data-testid="mfa-status-on">@Localizer["Mfa_On"]</span>
            }
            else if (_state != State.Loading)
            {
                <span class="badge bg-secondary-subtle text-secondary-emphasis">@Localizer["Mfa_Off"]</span>
            }
        </div>
        <p class="small text-muted mb-3">@Localizer["Mfa_Subtitle"]</p>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger py-2">@_error</div>
        }

        @if (_state == State.Loading)
        {
            <div class="text-muted"><span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Common_Loading"]</div>
        }
        else if (_state == State.Off)
        {
            <button class="btn btn-outline-primary" data-testid="mfa-enable" disabled="@_busy" @onclick="BeginEnroll">
                @if (_busy) { <span class="spinner-border spinner-border-sm me-2"></span> }
                @Localizer["Mfa_Enable"]
            </button>
        }
        else if (_state == State.Enrolling)
        {
            <ol class="small ps-3 mb-3">
                <li>@Localizer["Mfa_Step1"]</li>
                <li>@Localizer["Mfa_Step2"]</li>
            </ol>

            <div class="d-flex flex-wrap gap-4 align-items-start mb-3">
                <div id="mfa-qr" class="border rounded p-2 bg-white" style="width:168px;height:168px"></div>
                <div>
                    <div class="small text-muted mb-1">@Localizer["Mfa_ManualKey"]</div>
                    <code class="user-select-all d-inline-block mb-3" style="word-break:break-all" data-testid="mfa-secret">@_secret</code>
                    <div class="mb-2" style="max-width:220px">
                        <label class="form-label small fw-medium">@Localizer["Mfa_EnterCode"]</label>
                        <input type="text" inputmode="numeric" maxlength="6" data-testid="mfa-confirm-code"
                               class="form-control text-center" style="letter-spacing:.3rem"
                               placeholder="------" @bind="_code" @bind:event="oninput"
                               @onkeydown="OnConfirmKeyDown" disabled="@_busy" />
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-primary" data-testid="mfa-verify" disabled="@_busy" @onclick="ConfirmEnroll">
                    @if (_busy) { <span class="spinner-border spinner-border-sm me-2"></span> }
                    @Localizer["Mfa_Verify"]
                </button>
                <button class="btn btn-link" disabled="@_busy" @onclick="Cancel">@Localizer["Common_Cancel"]</button>
            </div>
        }
        else if (_state == State.ShowRecovery)
        {
            <div class="alert alert-success py-2">@Localizer["Mfa_EnabledNow"]</div>
            <p class="small mb-2">@Localizer["Mfa_RecoveryIntro"]</p>
            <div class="border rounded p-3 mb-3 bg-body-tertiary">
                <div class="row row-cols-2 g-1 font-monospace small">
                    @foreach (var rc in _recoveryCodes)
                    {
                        <div class="col user-select-all">@rc</div>
                    }
                </div>
            </div>
            <button class="btn btn-primary" data-testid="mfa-saved-codes" @onclick="FinishRecovery">@Localizer["Mfa_SavedCodes"]</button>
        }
        else if (_state == State.On)
        {
            @if (!_disabling)
            {
                <button class="btn btn-outline-danger" disabled="@_busy" @onclick="() => _disabling = true">
                    @Localizer["Mfa_Disable"]
                </button>
            }
            else
            {
                <div style="max-width:260px">
                    <label class="form-label small fw-medium">@Localizer["Mfa_DisablePrompt"]</label>
                    <input type="text" inputmode="text" maxlength="14"
                           class="form-control mb-2" placeholder="------"
                           @bind="_code" @bind:event="oninput"
                           @onkeydown="OnDisableKeyDown" disabled="@_busy" />
                    <div class="d-flex gap-2">
                        <button class="btn btn-danger" disabled="@_busy" @onclick="Disable">
                            @if (_busy) { <span class="spinner-border spinner-border-sm me-2"></span> }
                            @Localizer["Mfa_ConfirmDisable"]
                        </button>
                        <button class="btn btn-link" disabled="@_busy" @onclick="Cancel">@Localizer["Common_Cancel"]</button>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private enum State { Loading, Off, Enrolling, ShowRecovery, On }

    private State _state = State.Loading;
    private bool _busy;
    private bool _disabling;
    private bool _renderQrPending;
    private string? _error;
    private string _secret = string.Empty;
    private string? _provisioningUri;
    private string _code = string.Empty;
    private IReadOnlyList<string> _recoveryCodes = Array.Empty<string>();

    protected override async Task OnInitializedAsync() => await LoadStatus();

    private async Task LoadStatus()
    {
        try
        {
            var status = await Http.GetFromJsonAsync<MfaStatusDto>("/api/auth/mfa");
            _state = status?.Enabled == true ? State.On : State.Off;
        }
        catch { _error = Localizer["Mfa_ErrLoad"]; _state = State.Off; }
    }

    private async Task BeginEnroll()
    {
        _error = null; _busy = true;
        try
        {
            var res = await Http.PostAsync("/api/auth/mfa/enroll", null);
            if (!res.IsSuccessStatusCode) { _error = Localizer["Mfa_ErrEnroll"]; return; }
            var body = await res.Content.ReadFromJsonAsync<MfaEnrollDto>();
            if (body is null) { _error = Localizer["Mfa_ErrEnroll"]; return; }
            _secret = body.Secret;
            _provisioningUri = body.ProvisioningUri;
            _code = string.Empty;
            _state = State.Enrolling;
            _renderQrPending = true; // draw the QR once the element is in the DOM
        }
        catch { _error = Localizer["Mfa_ErrEnroll"]; }
        finally { _busy = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_renderQrPending && _provisioningUri is not null)
        {
            _renderQrPending = false;
            try { await JS.InvokeAsync<bool>("mfaQr.render", "mfa-qr", _provisioningUri); }
            catch { /* manual-entry key is still shown; QR is best-effort */ }
        }
    }

    private async Task ConfirmEnroll()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_code)) { _error = Localizer["Mfa_ErrEnterCode"]; return; }
        _busy = true;
        try
        {
            var res = await Http.PostAsJsonAsync("/api/auth/mfa/confirm", new { code = _code.Trim() });
            if (res.IsSuccessStatusCode)
            {
                var body = await res.Content.ReadFromJsonAsync<MfaRecoveryDto>();
                _recoveryCodes = body?.RecoveryCodes ?? Array.Empty<string>();
                _code = string.Empty;
                _state = State.ShowRecovery;
                return;
            }
            _error = Localizer["Mfa_ErrCodeIncorrect"];
        }
        catch { _error = Localizer["Mfa_ErrEnroll"]; }
        finally { _busy = false; }
    }

    private async Task FinishRecovery()
    {
        _recoveryCodes = Array.Empty<string>();
        _error = null;
        await LoadStatus();
    }

    private async Task Disable()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_code)) { _error = Localizer["Mfa_ErrEnterCode"]; return; }
        _busy = true;
        try
        {
            var res = await Http.PostAsJsonAsync("/api/auth/mfa/disable", new { code = _code.Trim() });
            if (res.IsSuccessStatusCode)
            {
                _code = string.Empty; _disabling = false;
                _state = State.Off;
                return;
            }
            _error = Localizer["Mfa_ErrCodeIncorrect"];
        }
        catch { _error = Localizer["Mfa_ErrDisable"]; }
        finally { _busy = false; }
    }

    private async Task Cancel()
    {
        _error = null; _disabling = false; _code = string.Empty;
        _provisioningUri = null;
        await JsClearQr();
        await LoadStatus();
    }

    private async Task JsClearQr()
    {
        try { await JS.InvokeVoidAsync("mfaQr.clear", "mfa-qr"); } catch { /* nothing rendered */ }
    }

    private async Task OnConfirmKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ConfirmEnroll();
    }

    private async Task OnDisableKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Disable();
    }

    private sealed record MfaStatusDto
    {
        [JsonPropertyName("enabled")] public bool Enabled { get; init; }
    }

    private sealed record MfaEnrollDto
    {
        [JsonPropertyName("provisioning_uri")] public string ProvisioningUri { get; init; } = string.Empty;
        [JsonPropertyName("secret")] public string Secret { get; init; } = string.Empty;
    }

    private sealed record MfaRecoveryDto
    {
        [JsonPropertyName("recovery_codes")] public IReadOnlyList<string>? RecoveryCodes { get; init; }
    }
}
