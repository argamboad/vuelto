@using System.Net.Http.Json
@using System.Text.Json.Serialization
@inject HttpClient Http
@inject IStringLocalizer<AppStrings> Localizer

@* Per-user notification delivery preferences (NOTIFY-2, ADR-013). *@
<div class="card shadow-sm mt-4">
    <div class="card-body">
        <h2 class="h6 fw-bold mb-2">@Localizer["NotifPrefs_Title"]</h2>
        <p class="small text-muted mb-3">@Localizer["NotifPrefs_Subtitle"]</p>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger py-2">@_error</div>
        }

        @if (_loading)
        {
            <div class="text-muted"><span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Common_Loading"]</div>
        }
        else
        {
            <div class="form-check form-switch mb-2">
                <input class="form-check-input" type="checkbox" id="notif-inapp"
                       data-testid="notif-prefs-inapp" checked="@_inApp" disabled="@_busy"
                       @onchange="e => Save(inApp: (bool)e.Value!, email: _email)" />
                <label class="form-check-label" for="notif-inapp">@Localizer["NotifPrefs_InApp"]</label>
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="notif-email"
                       data-testid="notif-prefs-email" checked="@_email" disabled="@_busy"
                       @onchange="e => Save(inApp: _inApp, email: (bool)e.Value!)" />
                <label class="form-check-label" for="notif-email">@Localizer["NotifPrefs_Email"]</label>
            </div>
        }
    </div>
</div>

@code {
    private bool _loading = true;
    private bool _busy;
    private bool _inApp = true;
    private bool _email = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var prefs = await Http.GetFromJsonAsync<PrefsDto>("/api/notifications/preferences");
            if (prefs is not null) { _inApp = prefs.InApp; _email = prefs.Email; }
        }
        catch { _error = Localizer["NotifPrefs_ErrLoad"]; }
        finally { _loading = false; }
    }

    private async Task Save(bool inApp, bool email)
    {
        _error = null; _busy = true;
        var prevInApp = _inApp; var prevEmail = _email;
        _inApp = inApp; _email = email; // optimistic
        try
        {
            var res = await Http.PutAsJsonAsync("/api/notifications/preferences", new { in_app = inApp, email });
            if (!res.IsSuccessStatusCode)
            {
                _inApp = prevInApp; _email = prevEmail; // revert
                _error = Localizer["NotifPrefs_ErrSave"];
            }
        }
        catch
        {
            _inApp = prevInApp; _email = prevEmail;
            _error = Localizer["NotifPrefs_ErrSave"];
        }
        finally { _busy = false; }
    }

    private sealed record PrefsDto
    {
        [JsonPropertyName("in_app")] public bool InApp { get; init; }
        [JsonPropertyName("email")] public bool Email { get; init; }
    }
}
