@using System.Net
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@inject HttpClient Http
@inject IStringLocalizer<AppStrings> Localizer

@* SKIN-9 · one dialog for creating and editing a budget line, so the lists never jump. Bootstrap's modal
   markup and classes, rendered by Blazor (the app loads no Bootstrap JS): the backdrop is a div, Escape is a
   keydown on the dialog, focus lands on the name. A new line picks its list here; an existing line does not
   change lists, so the switch is not offered on edit. Validation, the 409 inactive-name Reactivate offer and
   the single-currency payload are the same as the inline form this replaces. *@
<div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="budget-dialog-title"
     data-testid="budget-dialog" @onkeydown="OnKeyDown">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content line-dialog">
            <div class="modal-header">
                <h2 class="modal-title" id="budget-dialog-title">@(Editing is null ? Localizer["Budget_NewLine"] : Localizer["Budget_EditLine"])</h2>
                <button type="button" class="btn-close" aria-label="@Localizer["Common_Cancel"]" @onclick="Close"></button>
            </div>
            <div class="modal-body">
                @if (Editing is null)
                {
                    <div class="mb-3">
                        <SegmentedSwitch TestId="budget-dialog-kind" Label="@Localizer["Budget_Kind"].Value" Options="KindOptions()" Value="@_kind" ValueChanged="k => _kind = k" />
                    </div>
                }
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="exp-name">@Localizer["Catalog_Name"]</label>
                        <input class="form-control" id="exp-name" data-testid="exp-name" maxlength="100" disabled="@_saving" @ref="_nameInput" @bind="_name" @bind:event="oninput" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" for="exp-amount">@Localizer["Budget_Amount"]</label>
                        <div class="input-group">
                            <input class="form-control" type="number" step="0.01" min="0" id="exp-amount" data-testid="exp-amount" disabled="@_saving" @bind="_amount" />
                            <select class="form-select line-currency" id="exp-currency" aria-label="@Localizer["Tx_Currency"]" data-testid="exp-currency" disabled="@_saving" @bind="_currency"><option>CRC</option><option>USD</option></select>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="exp-category">@Localizer["Tx_Category"]</label>
                        <CategoryPicker Id="exp-category" TestId="exp-category" Categories="Categories" Disabled="@_saving" @bind-Value="_categoryId" OnCreated="OnCategoryCreated" />
                        <div class="form-text">@Localizer["Budget_CategoryHint"]</div>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="exp-bank">@Localizer["Tx_Bank"]</label>
                        <select class="form-select" id="exp-bank" data-testid="exp-bank" disabled="@_saving" @bind="_bankId">
                            <option value="">@Localizer["Budget_Unassigned"]</option>
                            @foreach (var b in Banks) { <option value="@b.Id">@b.Name</option> }
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="exp-method">@Localizer["Tx_PaymentMethod"]</label>
                        <select class="form-select" id="exp-method" data-testid="exp-method" disabled="@_saving" @bind="_method">
                            <option value="credit_card">@Localizer["Tx_CreditCard"]</option>
                            <option value="bank_account">@Localizer["Tx_BankAccount"]</option>
                        </select>
                    </div>
                    @if (Editing is not null)
                    {
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="exp-active" data-testid="exp-active" disabled="@_saving" @bind="_isActive" />
                                <label class="form-check-label" for="exp-active">@Localizer["Budget_ActiveToggle"]</label>
                            </div>
                        </div>
                    }
                </div>

                @if (_conflict is not null)
                {
                    <div class="alert alert-warning py-2 mt-3 d-flex align-items-center justify-content-between gap-2" data-testid="exp-conflict">
                        <span>@_conflict.Message</span>
                        <button type="button" class="btn btn-warning btn-sm" data-testid="exp-reactivate" disabled="@_saving" @onclick="ReactivateAsync">@Localizer["Catalog_Reactivate"]</button>
                    </div>
                }
                else if (_error is not null)
                {
                    <div class="alert alert-danger py-2 mt-3" data-testid="exp-form-error">@_error</div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-testid="exp-cancel" disabled="@_saving" @onclick="Close">@Localizer["Catalog_Cancel"]</button>
                <button type="button" class="btn btn-primary" data-testid="exp-save" disabled="@_saving" @onclick="SaveAsync">@(_saving ? Localizer["Catalog_Saving"] : Editing is null ? Localizer["Catalog_Create"] : Localizer["Catalog_Save"])</button>
            </div>
        </div>
    </div>
</div>
<div class="modal-backdrop fade show" @onclick="Close"></div>

@code {
    /// <summary>The list a NEW line goes to; an existing line's list is fixed by <see cref="Editing"/>'s own kind.</summary>
    [Parameter] public string Kind { get; set; } = "fixed";
    [Parameter] public ExpenseLine? Editing { get; set; }
    [Parameter] public IReadOnlyList<CategoryOption> Categories { get; set; } = [];
    [Parameter] public IReadOnlyList<ExpenseLinesSection.NamedItem> Banks { get; set; } = [];
    [Parameter] public EventCallback<CategoryOption> OnCategoryCreated { get; set; }

    /// <summary>Raised with the kind whose list changed, after a successful create, update or reactivation.</summary>
    [Parameter] public EventCallback<string> OnSaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string _kind = "fixed";
    private string _name = "";
    private decimal _amount;
    private string _currency = "CRC";
    private string _categoryId = "";
    private string _bankId = "";
    private string _method = "credit_card";
    private bool _isActive = true;
    private bool _saving;
    private string? _error;
    private ConflictDto? _conflict;
    private ElementReference _nameInput;

    private string Endpoint => $"/api/expenses/{_kind}";

    protected override void OnInitialized()
    {
        _kind = Kind;
        if (Editing is { } e)
        {
            _name = e.Name; _currency = e.Currency; _amount = e.Currency == MoneyDisplay.Crc ? e.BudgetCrc : e.BudgetUsd;
            _categoryId = e.CategoryId.ToString(); _bankId = e.BankId?.ToString() ?? ""; _method = e.PaymentMethod; _isActive = e.IsActive;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { try { await _nameInput.FocusAsync(); } catch { /* prerender / no DOM */ } }
    }

    private List<SegmentedOption> KindOptions() => [new("fixed", Localizer["Budget_Fixed"]), new("variable", Localizer["Budget_Variable"])];

    private Task Close() => OnClose.InvokeAsync();

    private async Task OnKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape" && !_saving) await Close(); }

    private object Payload(string name, bool isActive) => new
    {
        name,
        budget_crc = _currency == "CRC" ? _amount : 0m,
        budget_usd = _currency == "USD" ? _amount : 0m,
        payment_method = _method,
        category_id = _categoryId,
        bank_id = _bankId == "" ? null : _bankId,
        is_active = isActive,
    };

    private async Task SaveAsync()
    {
        _error = null; _conflict = null;
        if (string.IsNullOrWhiteSpace(_name)) { _error = Localizer["Catalog_NameRequired"]; return; }
        if (_amount <= 0) { _error = Localizer["Budget_AmountRequired"]; return; }
        if (_categoryId == "") { _error = Localizer["Tx_Validation_Category"]; return; }

        _saving = true;
        try
        {
            var res = Editing is null
                ? await Http.PostAsJsonAsync(Endpoint, Payload(_name, true))
                : await Http.PutAsJsonAsync($"{Endpoint}/{Editing.Id}", Payload(_name, _isActive));
            if (res.IsSuccessStatusCode) await OnSaved.InvokeAsync(_kind);
            else if (res.StatusCode == HttpStatusCode.Conflict)
            {
                var conflict = await res.Content.ReadFromJsonAsync<ConflictDto>();
                if (conflict?.ExistingId is not null) _conflict = conflict; else _error = conflict?.Message ?? Localizer["Catalog_NameExists"];
            }
            else _error = (await res.Content.ReadFromJsonAsync<ConflictDto>())?.Message ?? Localizer["Catalog_SaveError"];
        }
        catch { _error = Localizer["Catalog_SaveError"]; }
        finally { _saving = false; }
    }

    /// <summary>Restores the inactive line under its stored name, with the budget/category/bank just typed.</summary>
    private async Task ReactivateAsync()
    {
        if (_conflict is not { ExistingId: { } id } conflict) return;
        _saving = true;
        try
        {
            var res = await Http.PutAsJsonAsync($"{Endpoint}/{id}", Payload(conflict.ExistingName ?? _name, true));
            if (res.IsSuccessStatusCode) await OnSaved.InvokeAsync(_kind);
            else { _conflict = null; _error = (await res.Content.ReadFromJsonAsync<ConflictDto>())?.Message ?? Localizer["Catalog_ReactivateError"]; }
        }
        catch { _conflict = null; _error = Localizer["Catalog_ReactivateError"]; }
        finally { _saving = false; }
    }

    private sealed record ConflictDto(
        [property: JsonPropertyName("error")] string Error,
        [property: JsonPropertyName("message")] string Message,
        [property: JsonPropertyName("existing_id")] Guid? ExistingId,
        [property: JsonPropertyName("existing_name")] string? ExistingName);
}
