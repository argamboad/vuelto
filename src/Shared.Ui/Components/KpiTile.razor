@* SKIN-2 · label, number, one sub-line. The value is a fragment rather than a string so a caller can pass a
   <Money> and get the stacked treatment; the sub-line is the one place a tile explains itself, and a tile
   with nothing to add renders no empty row. *@
<div class="kpi" data-testid="@TestId" data-tone="@Tone">
    <div class="kpi-label" data-testid="@Id("label")">@Label</div>
    <div class="kpi-value" data-testid="@Id("value")">@Value</div>
    @if (!string.IsNullOrWhiteSpace(Sub))
    {
        <div class="kpi-sub" data-testid="@Id("sub")">@Sub</div>
    }
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? Value { get; set; }

    /// <summary>One short line under the number. Omitted entirely when blank.</summary>
    [Parameter] public string? Sub { get; set; }

    /// <summary>neutral (default) · good · bad — colours the number only, and only when it means over/under budget.</summary>
    [Parameter] public string Tone { get; set; } = "neutral";

    [Parameter] public string TestId { get; set; } = "kpi";

    private string Id(string part) => $"{TestId}-{part}";
}
