<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Vuelto's host: the web app that runs the platform (Perezosoft.Platform.Api) with the app's half — AppComposition.cs
    and Features/ — and owns what a host owns: configuration, launch profiles, the EF design-time factory, the migrations.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Perezosoft.Platform.Api" />
    <!-- vuelto's own: the report PDFs (REPORTS-7) and the bank vouchers' HTML (EMAIL-1, MIT). -->
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="HtmlAgilityPack" />
    <!-- The EF design-time host (the startup project of dotnet ef): AppDbContextFactory lives here. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The integration tests boot this host (WebApplicationFactory<Program>). -->
    <InternalsVisibleTo Include="Vuelto.Api.Tests" />
  </ItemGroup>

  <!-- REPORTS-7: the PDF typeface (Nunito, SIL OFL 1.1, licence beside the files) and the light-background brand lockup,
       linked from the UI library's brand folder so the brand keeps a single source file. -->
  <ItemGroup>
    <EmbeddedResource Include="Features/Reports/Pdf/Assets/Nunito-Regular.ttf" LogicalName="Vuelto.Reports.Pdf.Nunito-Regular.ttf" />
    <EmbeddedResource Include="Features/Reports/Pdf/Assets/Nunito-SemiBold.ttf" LogicalName="Vuelto.Reports.Pdf.Nunito-SemiBold.ttf" />
    <EmbeddedResource Include="Features/Reports/Pdf/Assets/Nunito-Bold.ttf" LogicalName="Vuelto.Reports.Pdf.Nunito-Bold.ttf" />
    <EmbeddedResource Include="../Shared.Ui/wwwroot/brand/lockup_light.svg" Link="Features/Reports/Pdf/Assets/lockup_light.svg" LogicalName="Vuelto.Reports.Pdf.lockup_light.svg" />
  </ItemGroup>

  <!-- vuelto's mails (PlatformBrand, AppComposition.ConfigurePlatform): its logo, embedded. -->
  <ItemGroup>
    <EmbeddedResource Include="Email/Assets/logo.png" LogicalName="Vuelto.Host.Email.logo.png" />
  </ItemGroup>

</Project>
