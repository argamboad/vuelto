<Project>
  <!--
    The local source switch, part 2 (Pkg 2.4; part 1, PlatformSource.props, decides whether it is on). Imported after
    the project, so the project's own PackageReferences exist. For each one the platform's package map lists
    (platform-packages.props, read from the checkout it points at): drop the package, reference the checkout's project.
    Packages the map does not list (nuget.org ones, an app's own) are untouched.
  -->
  <Import Project="$(_PlatformSourceDir)platform-packages.props" Condition="'$(PlatformSource)' != '' and Exists('$(_PlatformSourceDir)platform-packages.props')" />

  <!--
    Building against source changes the dependency graph, so the restore must neither fail on the committed lockfile
    nor rewrite it: switched restores lock into obj/, never in locked mode. Switch off, and the committed
    packages.lock.json is what restore checks again. Set here, not in the .props half: Directory.Build.props is
    imported before the SDK defines obj/ (MSBuildProjectExtensionsPath), so there the path would be the project folder.
  -->
  <PropertyGroup Condition="'$(PlatformSource)' != ''">
    <NuGetLockFilePath>$(MSBuildProjectExtensionsPath)platform-source.packages.lock.json</NuGetLockFilePath>
    <RestoreLockedMode>false</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup Condition="'$(PlatformSource)' != ''">
    <!-- The intersection of the map and this project's references, keeping the map's Source metadata (not "Project": ProjectReference reserves that name). -->
    <_PlatformPackageNotReferenced Include="@(PlatformPackage)" Exclude="@(PackageReference)" />
    <_PlatformPackageReferenced Include="@(PlatformPackage)" Exclude="@(_PlatformPackageNotReferenced)" />
    <PackageReference Remove="@(_PlatformPackageReferenced)" />
    <ProjectReference Include="@(_PlatformPackageReferenced->'$(_PlatformSourceDir)%(Source)')" />
  </ItemGroup>

  <!-- A switch pointed at the wrong place fails loudly instead of quietly building against the packages. -->
  <Target Name="_CheckPlatformSource" BeforeTargets="CollectPackageReferences;ResolveProjectReferences;Restore"
          Condition="'$(PlatformSource)' != ''">
    <Error Condition="!Exists('$(_PlatformSourceDir)platform-packages.props')"
           Text="PlatformSource is set to '$(PlatformSource)', which is not a platform checkout (no platform-packages.props). Fix PLATFORM_SOURCE in .env, or clear it to build against the packages." />
    <Message Importance="high" Condition="'@(_PlatformPackageReferenced)' != ''"
             Text="$(MSBuildProjectName): platform packages from SOURCE ($(PlatformSource)): @(_PlatformPackageReferenced)" />
  </Target>
</Project>
