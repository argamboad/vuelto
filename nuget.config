<?xml version="1.0" encoding="utf-8"?>
<!-- NuGet sources (Pkg 2.2, ADR-034). nuget.org for everything; the platform's own packages (Perezosoft.Platform.*)
     come from the GitHub Packages feed under argamboad. Source mapping sends each package to ONE source, so a
     restore that needs no platform package never contacts the feed (and needs no credential), and no platform
     package id can be served from nuget.org. The credential is never in this file: `ws setup`, bin/cloud-setup
     and the tools write it to the user-level NuGet config from PLATFORM_PACKAGES_TOKEN in the repo's .env. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="perezosoft" value="https://nuget.pkg.github.com/argamboad/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="perezosoft">
      <package pattern="Perezosoft.Platform.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
