# ═════════════════════════════════════════════════════════════════════════════
# perezosoft — local dev config template  (.env is gitignored; never commit it)
# ═════════════════════════════════════════════════════════════════════════════
# Read by docker-compose (the container vars) and by the API via DotNetEnv (the
# Section__Key values; __ marks section nesting). See docs/DECISIONS.md.
# Layout: Containers → Required keys → Configuration reference (defaults for every knob).

# ── Containers: PostgreSQL (docker-compose) ──────────────────────────────────
DB_NAME=dev_db
DB_USER=dev
DB_PASSWORD=devpassword
DB_PORT=5433

# ── Containers: Mailpit SMTP trap (docker-compose) ───────────────────────────
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025

# ── Required: Postgres connection — mirror the DB_* values above ─────────────
ConnectionStrings__DefaultConnection="Host=localhost;Port=5433;Database=dev_db;Username=dev;Password=devpassword"

# ── Required: JWT signing key — min 32 chars; generate a random value ────────
Jwt__Secret=

# ═════════════════════════════════════════════════════════════════════════════
# CONFIGURATION REFERENCE — every knob the API reads, with its default
# ═════════════════════════════════════════════════════════════════════════════
# Each line shows Section__Key=<effective default>. Uncomment + edit to override.
# Defaults come from src/Api/appsettings.json and the code fallbacks in SettingsProvider.cs
# + the *Settings classes. Anything not listed here is compiled-in (see "Not configurable").

# ── Tokens / session ─────────────────────────────────────────────────────────
#Jwt__Issuer=Perezosoft
#Jwt__ExpiryMinutes=60                        # access-token lifetime (minutes)
#RefreshToken__ExpiryDays=30                  # refresh-token lifetime (days)

# ── URLs / origins ───────────────────────────────────────────────────────────
#Auth__AppBaseUrl=https://localhost:7008      # public client origin; set to the prod URL when deployed
#Auth__AllowedOrigins__0=                     # extra CORS origin (repeat __1, __2…); single-origin deploy needs none
#Auth__Native__CallbackScheme=perezosoft      # native (MAUI) OAuth callback URL scheme

# ── Passwordless: OTP + magic link + invites ─────────────────────────────────
#Auth__Otp__CodeLifespanMinutes=10            # OTP validity (minutes)
#Auth__Otp__Length=6                          # OTP digit count
#Auth__Otp__MaxAttempts=5                     # failed guesses before lockout
#Auth__Otp__LockoutWindowMinutes=15           # lockout window (minutes) — see NOTE at end
#Auth__MagicLink__TokenLifespanMinutes=15     # magic-link validity (minutes)
#Auth__Mfa__MaxAttempts=5                     # failed step-up (TOTP/recovery) guesses per user before lockout (ADM-3)
#Auth__Mfa__LockoutWindowMinutes=15           # how long a user's MFA step-up stays locked once the cap is hit
#Auth__Invitation__LifespanDays=7             # household-invite validity (days)
#Auth__RateLimit__PasswordlessPermitLimit=5   # SEND requests / IP / minute (E2E raises to 1000).
                                              # The VERIFY budget is derived as max(this, MaxAttempts+5), i.e. 10 by default.

# ── OAuth providers (each stays OFF until its ClientId is set) ────────────────
#Authentication__Google__ClientId=
#Authentication__Google__ClientSecret=
#Authentication__Microsoft__ClientId=
#Authentication__Microsoft__ClientSecret=
#Authentication__Microsoft__Tenant=consumers  # consumers | common | organizations | <tenant-guid>

# ── Email / SMTP (unset Host ⇒ Mailpit trap at localhost:1025 in dev; no email in prod) ─
#Email__Smtp__Host=
#Email__Smtp__Port=587
#Email__Smtp__Username=
#Email__Smtp__Password=
#Email__Smtp__FromAddress=
#Email__Smtp__FromName=Perezosoft
#Email__Smtp__TimeoutSeconds=30               # per-send SMTP timeout (seconds)
#Email__Smtp__CheckCertificateRevocation=true # set false ONLY on macOS dev boxes; never in prod

# ── Billing / Stripe (unset SecretKey ⇒ in-memory FakeBillingProvider, zero real charges) ─
#Billing__Stripe__SecretKey=                  # sk_test_... / sk_live_...
#Billing__Stripe__ExpectLiveKey=              # true (prod) / false (staging): fail closed if SecretKey mode mismatches; unset = no check
#Billing__Stripe__Prices__pro=                # one per paid plan, keyed by plan (price_...)
#Billing__Stripe__WebhookSecret=              # whsec_... (verify inbound webhooks)

# ── File storage (unset S3 Bucket ⇒ local disk under ./storage) ──────────────
#Storage__S3__Bucket=                         # set ⇒ switch to S3-compatible backend
#Storage__S3__Region=                         # e.g. us-east-1
#Storage__S3__Endpoint=                       # set for MinIO/R2/B2; empty ⇒ AWS
#Storage__S3__AccessKey=
#Storage__S3__SecretKey=
#Storage__S3__ForcePathStyle=false            # true for MinIO/R2/B2
#Storage__Local__RootPath=                    # empty ⇒ ./storage under the app base dir
#Storage__Local__DownloadBaseUrl=             # API public origin for /api/files/{token}; empty ⇒ relative URL

# ── Feature gates (all default OFF) ──────────────────────────────────────────
#PublicApi__Enabled=false                     # public API + tenant API keys (PUBAPI)
#Webhooks__Enabled=false                      # outbound webhooks (HOOKS)
#Hosting__ServeWebClient=false                # API also serves the published Blazor WASM (single origin)
#Proxy__Enabled=false                         # honor X-Forwarded-*; turn on ONLY behind a trusted proxy
                                              # ⚠ ON + no KnownNetworks below = trust ANY peer's X-Forwarded-For.
                                              # Safe only if the proxy is the app's SOLE ingress (the managed-
                                              # proxy case, e.g. Render). If the app is ALSO reachable directly,
                                              # any client can forge its source IP and bypass the per-IP rate
                                              # limit (and via it the MFA attempt cap) — set KnownNetworks.
#Proxy__KnownNetworks__0=                     # CIDR (repeat __1, __2…); set ⇒ honor X-Forwarded-* ONLY from a
                                              # peer inside these ranges. Empty ⇒ trust any peer (see above).
                                              # Invalid CIDR = startup failure (fail closed, never trust-all).
#Proxy__ForwardLimit=1                        # proxy hops to walk back, from the right. 1 = trust only what the
                                              # nearest proxy appended, so a client can't pre-seed the header.
                                              # Raise ONLY to the real number of proxies in front. Min 1.
#Rls__EnforceRuntimeRole=false                # fail-closed RLS posture guard (staging/prod)

# ── Platform-staff admin (out-of-band; never a tenant role; empty ⇒ no staff) ─
#Admin__StaffEmails__0=                        # repeat __1, __2… for more addresses

# ── Observability ────────────────────────────────────────────────────────────
#OpenTelemetry__Otlp__Endpoint=               # e.g. http://localhost:4317; empty ⇒ no exporter
#OpenTelemetry__ConsoleExporter=false         # print telemetry to stdout for local debugging
#Logging__LogLevel__Default=Information

# ── Two-role RLS topology (advanced; ADR-020) ────────────────────────────────
# Local dev's `dev` user is a Postgres superuser, so RLS is bypassed by design. To run the app
# RLS-enforced like staging/prod: point DefaultConnection at the non-privileged app_runtime role
# (provisioned by docker/db/provision-rls-runtime-role.sql), keep the owner conn for migrations,
# and enable the posture guard (Rls__EnforceRuntimeRole=true above).
#ConnectionStrings__DefaultConnection="Host=localhost;Port=5433;Database=dev_db;Username=app_runtime;Password=app_runtime_password"
#ConnectionStrings__Migrations="Host=localhost;Port=5433;Database=dev_db;Username=dev;Password=devpassword"

# ── Deploy/host-injected (read via Environment.GetEnvironmentVariable, not IConfiguration) ──
#APP_BUILD_COMMIT=                            # build SHA shown by /api/version; CI/deploy injects it
#RENDER_GIT_COMMIT=                           # Render's own commit var — /api/version fallback when APP_BUILD_COMMIT is unset
#PEREZOSOFT_API_BASE_URL=                     # native (MAUI) dev override for the API origin; unset ⇒ platform default

# ── Not configurable (compiled-in constants; listed so the limits are visible) ─
#   • Passwordless rate-limit WINDOW: 1 minute (fixed).
#   • OTP-verify rate-limit budget: max(PasswordlessPermitLimit, Otp.MaxAttempts + 5) — derived, not a key.
#   • Public-API throttle: 60 requests / API key / minute (fixed).
#   • OAuth external sign-in cookie: 10-minute lifetime (fixed).
#   • JWT algorithm (HS256) and refresh-cookie name/flags: fixed.
#
# NOTE — the OTP lockout is a SLIDING window: after MaxAttempts failures the email is blocked
# until ~LockoutWindowMinutes (15) after the code was ISSUED, not after the last guess.
# Requesting a fresh code neither resets nor extends the lock.
