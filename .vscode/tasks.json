{
  // The tasks behind the start profiles that tools/dev-profiles.ps1 writes into the gitignored .vscode/settings.json
  // (run it once per clone; see docs/MOBILE_TESTING.md §3). Folder paths, not project names, so a rebrand leaves this
  // file alone. Each profile builds only what it runs: the API's projects and the clients' share none, so its two
  // builds can run side by side. The Windows TFM matches src/Maui's csproj.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: api",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/src/Api", "-v", "q"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build: web",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/src/Web", "-v", "q"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build: windows desktop",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/src/Maui", "-f", "net10.0-windows10.0.19041.0", "-v", "q"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "android: phone emulator",
      "command": "pwsh",
      "type": "process",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/tools/android-emulator.ps1", "-Avd", "phone", "-Port", "5554"],
      "problemMatcher": []
    },
    {
      "label": "android: tablet emulator",
      "command": "pwsh",
      "type": "process",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/tools/android-emulator.ps1", "-Avd", "tablet", "-Port", "5556"],
      "problemMatcher": []
    }
  ]
}
