{
  "$comment": [
    "Who owns each file of this tree (Arch A2, R160; the classes of Pkg 6.4, #423). Ordered rules, first match wins; every",
    "tracked file must match one (OwnershipMap_ClassifiesEveryTrackedFile). Globs are git-style: ** spans folders, * stays",
    "inside one. The same map classes the platform's tree and an app's (starter/ carries it as it is).",
    "  platform  the platform's own: the source the packages ship and its tests. Never in an app on the packages; a clone",
    "            that still carries a copy converts to the packages rather than port it.",
    "  register  held in step: what every app carries as the platform wrote it (the source switch, the SDK pin, the feed,",
    "            the host's entry point, the test host and fixtures, the one-line suites). An app on the packages is held",
    "            to the copies the Testing package embeds (starter/'s, its placeholder renamed to the app's brand); a",
    "            difference fails unless tests/Api.Tests/App/PlatformDivergences.json lists it with a reason.",
    "  seed      the app's after `dotnet new` (its UI, journeys, config, project files, docs): never written by the port",
    "            tool, which lists what the platform added, changed or deleted in it since the app's version.",
    "  app       the app's own: slices, the app halves of the seams (Arch A1), its context and every migration (ADR-034).",
    "  sample    the DELETE-ME Notes slice: may be absent downstream.",
    "  producer  the publisher's alone (Pkg 2.5): the release machinery and the package map. Never ported, never in a",
    "            manifest; the gates that read these files run only in the platform (its stamp's commit is null).",
    "keep: tokens the brand map never rewrites (Pkg 2.5, ADR-034): the platform's package ids (also lower-case, as",
    "dotnet-tools.json spells the tool's), its feed key and NuGet's credential variable for it keep their names in every app.",
    "The port tool reads this list from the platform release it ports to; the gate spells paths with it.",
    "An app classes its own top-level folders in platform-ownership.App.json (same shape, its rules apply after these).",
    "The port tool (tools/port-platform.ps1, `dotnet platform port`) merges the register from starter/ at the app's",
    "release to the target release and stamps the version (platform-stamp.json, \"commit\"); a clone's run merges register",
    "and seed files from platform commits and writes the manifest its gate compares against."
  ],
  "keep": [ "Perezosoft.Platform.", "perezosoft.platform.", "key=\"perezosoft\"", "NuGetPackageSourceCredentials_perezosoft" ],
  "rules": [
    { "glob": ".github/workflows/release.yml", "class": "producer" },
    { "glob": ".github/release-note-template.md", "class": "producer" },
    { "glob": "tools/release/**", "class": "producer" },
    { "glob": "tests/ci-logic/cases/release-plan/**", "class": "producer" },
    { "glob": "platform-packages.props", "class": "producer" },
    { "glob": "tests/Client.Tests/**", "class": "producer" },
    { "glob": "src/Templates/**", "class": "producer" },
    { "glob": "starter/**", "class": "producer" },
    { "glob": "src/Host/Features/Notes/**", "class": "sample" },
    { "glob": "src/Core/Entities/Note.cs", "class": "sample" },
    { "glob": "src/Host/Persistence/Configurations/NoteConfiguration.cs", "class": "sample" },
    { "glob": "tests/Api.Tests/NotesSliceTests.cs", "class": "sample" },
    { "glob": "src/Host/Persistence/Migrations/*_AddNotesSample.*", "class": "sample" },
    { "glob": "src/Host/Persistence/Migrations/*_NotesSampleRlsPolicy.*", "class": "sample" },
    { "glob": "_PLATFORM_PRIMER.md", "class": "sample" },

    { "glob": "src/Core/**", "class": "platform" },
    { "glob": "src/Infrastructure/**", "class": "platform" },
    { "glob": "src/Api/**", "class": "platform" },
    { "glob": "src/Client/**", "class": "platform" },
    { "glob": "src/Client.Web/**", "class": "platform" },
    { "glob": "src/Client.Maui/**", "class": "platform" },
    { "glob": "src/Testing/**", "class": "platform" },
    { "glob": "src/Testing.Ui/**", "class": "platform" },
    { "glob": "src/Testing.E2E/**", "class": "platform" },
    { "glob": "src/Build/**", "class": "platform" },
    { "glob": "src/Tool/**", "class": "platform" },

    { "glob": "src/Host/Features/**", "class": "app" },
    { "glob": "src/Host/AppComposition.cs", "class": "app" },
    { "glob": "src/Host/Persistence/AppDbContext.cs", "class": "app" },
    { "glob": "src/Host/Persistence/Migrations/**", "class": "app" },
    { "glob": "tests/Api.Tests/App/**", "class": "app" },
    { "glob": "tests/Api.Tests/ArchitectureTests.cs", "class": "app" },
    { "glob": "tests/Ui.Tests/App/**", "class": "app" },
    { "glob": "**/packages.lock.json", "class": "app" },
    { "glob": "platform-stamp.json", "class": "app" },
    { "glob": "platform-ownership.App.json", "class": "app" },

    { "glob": "src/Host/Program.cs", "class": "register" },
    { "glob": "src/Host/Persistence/AppDbContextFactory.cs", "class": "register" },
    { "glob": "tests/Api.Tests/Infrastructure/**", "class": "register" },
    { "glob": "tests/Api.Tests/PlatformTestingUsings.cs", "class": "register" },
    { "glob": "tests/Api.Tests/CompositionSmokeTests.cs", "class": "register" },
    { "glob": "tests/Api.Tests/OwnershipTests.cs", "class": "register" },
    { "glob": "tests/Api.Tests/PlatformSchemaTests.cs", "class": "register" },
    { "glob": "tests/Api.Tests/TenancyTests.cs", "class": "register" },
    { "glob": "platform-ownership.json", "class": "register" },
    { "glob": ".config/**", "class": "register" },
    { "glob": "build/PlatformSource.*", "class": "register" },
    { "glob": "docker/**", "class": "register" },
    { "glob": "Directory.Build.props", "class": "register" },
    { "glob": "Directory.Build.targets", "class": "register" },
    { "glob": "global.json", "class": "register" },
    { "glob": "nuget.config", "class": "register" },
    { "glob": ".gitattributes", "class": "register" },

    { "glob": "src/Host/**", "class": "seed" },
    { "glob": "src/Shared.Ui/**", "class": "seed" },
    { "glob": "src/Web/**", "class": "seed" },
    { "glob": "src/Maui/**", "class": "seed" },

    { "glob": "tests/E2E.Tests/**", "class": "seed" },
    { "glob": "tests/native-smoke-android/**", "class": "seed" },
    { "glob": "tests/Ui.Tests/**", "class": "seed" },
    { "glob": "tests/Api.Tests/*.csproj", "class": "seed" },
    { "glob": "tests/Api.Tests/**", "class": "platform" },
    { "glob": "tests/Core.Tests/**", "class": "platform" },
    { "glob": "tests/js-logic/**", "class": "platform" },
    { "glob": "tests/ci-logic/**", "class": "platform" },

    { "glob": "tools/**", "class": "platform" },
    { "glob": ".github/scripts/**", "class": "platform" },
    { "glob": ".github/workflows/app-ci.yml", "class": "platform" },
    { "glob": ".github/**", "class": "seed" },

    { "glob": "docs/audits/**", "class": "platform" },
    { "glob": "docs/tutorial/**", "class": "platform" },
    { "glob": "docs/*.py", "class": "platform" },
    { "glob": "docs/requirements.txt", "class": "platform" },
    { "glob": "docs/**", "class": "seed" },

    { "glob": "build/Packing.*", "class": "platform" },
    { "glob": "Directory.Packages.props", "class": "seed" },
    { "glob": "local-ports.props", "class": "seed" },
    { "glob": "*.slnx", "class": "seed" },
    { "glob": ".vscode/**", "class": "seed" },
    { "glob": "Dockerfile", "class": "seed" },
    { "glob": ".dockerignore", "class": "seed" },
    { "glob": "docker-compose.yml", "class": "seed" },
    { "glob": "render.yaml", "class": "seed" },
    { "glob": ".env.example", "class": "seed" },
    { "glob": ".gitignore", "class": "seed" },
    { "glob": ".gitleaks.toml", "class": "seed" },
    { "glob": "CLAUDE.md", "class": "seed" },
    { "glob": "CONTRIBUTING.md", "class": "seed" },
    { "glob": "README.md", "class": "seed" }
  ]
}
