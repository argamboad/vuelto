{
  "$comment": [
    "Who owns each file of this tree (Arch A2, R160). Ordered rules, first match wins; every tracked file must match one",
    "(OwnershipMap_ClassifiesEveryTrackedFile). Globs are git-style: ** spans folders, * stays inside one.",
    "  platform  the platform's: identical in every app modulo the brand tokens; downstream, a change needs an entry in",
    "            tests/Api.Tests/App/PlatformDivergences.json with a reason, or the gate fails.",
    "  adapts    platform origin, the app is expected to edit (its UI, its journeys, its config, its docs): drift is reported.",
    "  app       the app's own: slices, the app halves of the seams (Arch A1), app entities and migrations. Never ported.",
    "  sample    the DELETE-ME Notes slice: may be absent downstream.",
    "The port tool (tools/port-platform.ps1) merges platform and adapts files from the stamped platform commit and writes",
    "the manifest the gate compares against; the stamp (platform-stamp.json) names that commit."
  ],
  "rules": [
    { "glob": "src/Api/Features/Notes/**", "class": "sample" },
    { "glob": "src/Core/Entities/Note.cs", "class": "sample" },
    { "glob": "src/Infrastructure/Persistence/Configurations/NoteConfiguration.cs", "class": "sample" },
    { "glob": "tests/Api.Tests/NotesSliceTests.cs", "class": "sample" },
    { "glob": "src/Infrastructure/Persistence/Migrations/*_AddNotesSample.*", "class": "sample" },
    { "glob": "src/Infrastructure/Persistence/Migrations/*_NotesSampleRlsPolicy.*", "class": "sample" },

    { "glob": "src/Api/Features/**", "class": "app" },
    { "glob": "src/Api/AppComposition.cs", "class": "app" },
    { "glob": "src/Infrastructure/Persistence/AppDbContext.App.cs", "class": "app" },
    { "glob": "tests/Api.Tests/App/**", "class": "app" },
    { "glob": "tests/Api.Tests/RulesEnforcement.App.cs", "class": "app" },
    { "glob": "tests/Ui.Tests/App/**", "class": "app" },
    { "glob": "platform-stamp.json", "class": "app" },

    { "glob": "src/Infrastructure/Persistence/Migrations/*ModelSnapshot.cs", "class": "adapts" },
    { "glob": "src/Infrastructure/Email/BrandedEmail.cs", "class": "adapts" },
    { "glob": "src/Infrastructure/Email/EmailStrings*.resx", "class": "adapts" },
    { "glob": "src/Api/appsettings*.json", "class": "adapts" },
    { "glob": "src/Api/Properties/launchSettings.json", "class": "adapts" },
    { "glob": "src/Api/*.csproj", "class": "adapts" },
    { "glob": "src/Api/*.http", "class": "adapts" },
    { "glob": "src/Infrastructure/*.csproj", "class": "adapts" },
    { "glob": "src/Core/*.csproj", "class": "adapts" },
    { "glob": "**/packages.lock.json", "class": "adapts" },

    { "glob": "src/Core/**", "class": "platform" },
    { "glob": "src/Infrastructure/**", "class": "platform" },
    { "glob": "src/Api/**", "class": "platform" },

    { "glob": "src/Shared.Ui/**", "class": "adapts" },
    { "glob": "src/Web/**", "class": "adapts" },
    { "glob": "src/Maui/**", "class": "adapts" },

    { "glob": "tests/E2E.Tests/**", "class": "adapts" },
    { "glob": "tests/native-smoke-android/**", "class": "adapts" },
    { "glob": "tests/Ui.Tests/**", "class": "adapts" },
    { "glob": "tests/Core.Tests/**", "class": "adapts" },
    { "glob": "tests/js-logic/**", "class": "adapts" },
    { "glob": "tests/Api.Tests/*.csproj", "class": "adapts" },
    { "glob": "tests/Api.Tests/**", "class": "platform" },
    { "glob": "tests/ci-logic/**", "class": "platform" },

    { "glob": "tools/**", "class": "platform" },
    { "glob": ".github/scripts/**", "class": "platform" },
    { "glob": ".github/workflows/**", "class": "adapts" },
    { "glob": ".github/**", "class": "adapts" },

    { "glob": "docs/audits/**/FOUNDATION_RULES*.md", "class": "platform" },
    { "glob": "docs/audits/**", "class": "adapts" },
    { "glob": "docs/tutorial/**", "class": "adapts" },
    { "glob": "docs/postman/**", "class": "adapts" },
    { "glob": "docs/stories/**", "class": "adapts" },
    { "glob": "docs/brand/**", "class": "adapts" },
    { "glob": "docs/qa-runs/**", "class": "adapts" },
    { "glob": "docs/*.py", "class": "platform" },
    { "glob": "docs/requirements.txt", "class": "platform" },
    { "glob": "docs/**", "class": "adapts" },

    { "glob": "platform-ownership.json", "class": "platform" },
    { "glob": "platform-schema.json", "class": "platform" },
    { "glob": ".config/**", "class": "platform" },
    { "glob": "docker/**", "class": "platform" },
    { "glob": ".vscode/**", "class": "adapts" },
    { "glob": "local-ports.props", "class": "adapts" },
    { "glob": "Directory.Build.props", "class": "platform" },
    { "glob": "Directory.Packages.props", "class": "adapts" },
    { "glob": "global.json", "class": "platform" },
    { "glob": "*.slnx", "class": "adapts" },
    { "glob": "Dockerfile", "class": "adapts" },
    { "glob": ".dockerignore", "class": "platform" },
    { "glob": "docker-compose.yml", "class": "adapts" },
    { "glob": "render.yaml", "class": "adapts" },
    { "glob": ".env.example", "class": "adapts" },
    { "glob": ".gitattributes", "class": "platform" },
    { "glob": ".gitignore", "class": "adapts" },
    { "glob": ".gitleaks.toml", "class": "adapts" },
    { "glob": "CLAUDE.md", "class": "adapts" },
    { "glob": "CONTRIBUTING.md", "class": "adapts" },
    { "glob": "README.md", "class": "adapts" },
    { "glob": "_PLATFORM_PRIMER.md", "class": "sample" }
  ]
}
